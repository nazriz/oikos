{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "noEmit": true
  },
  "include": ["src", "test"],
  "exclude": ["**/node_modules"]
}
