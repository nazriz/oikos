{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "seats",
    "translator",
    "orchestrator",
    "worlds",
    "measure",
    "pilot-view",
    "contracts/test",
    "docs/research/cel-check",
    "renderer",
    "explorer/web",
    "explorer/test",
    "explorer/build.ts"
  ],
  "exclude": [
    "**/node_modules"
  ]
}
