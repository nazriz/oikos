      "does": "Says what is decided on an application, to both sides. It moves no money and does nothing by itself: an order or a recommendation is words, which the other side follows or does not.",
      "fields": {
        "about": {
          "description": "The paper the application is about, where it names one.",
          "type": "record"
        },
        "against": {
          "description": "Whom it was against.",
          "type": "entity"
        },
        "amount": {
          "description": "For pay: how much.",
          "type": "amount"
        },
        "applicant": {
          "description": "Who applied.",
          "required": true,
          "type": "entity"
        },
        "application": {
          "description": "The application decided.",
          "required": true,
          "type": "record"
        },
        "binding": {
