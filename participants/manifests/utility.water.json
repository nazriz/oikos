{
  "name": "utility.water",
  "version": "0.3.0",
  "doc": "docs/behaviour/utilities.md",
  "params": {
    "bill_every_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 91,
      "source": "placeholder"
    },
    "litres_per_person_per_day": {
      "schema": {
        "type": "integer",
        "description": "what a person uses (the world's figure)"
      },
      "default": 0,
      "source": "placeholder"
    },
    "meter": {
      "schema": {
        "type": "string"
      },
      "default": "water_used",
      "source": "placeholder"
    },
    "meters": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "part": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "price_per_kl": {
      "schema": {
        "type": "integer",
        "description": "the tariff (cents)"
      },
      "default": 0,
      "source": "placeholder"
    },
    "read_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 21,
      "source": "placeholder"
    },
    "roll": {
      "schema": {
        "type": "string"
      },
      "default": "roll",
      "source": "placeholder"
    },
    "service_per_quarter": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "task": {
      "schema": {
        "type": "string",
        "description": "the work that draws a kilolitre"
      },
      "default": "draw_water",
      "source": "placeholder"
    },
    "works": {
      "schema": {
        "type": "string",
        "description": "the water works (the world must say): where it draws from the river"
      },
      "default": "",
      "required": true,
      "source": "the water works (the world must say): where it draws from the river"
    }
  },
  "perceives": [],
  "state": "none",
  "keeps": [
    {
      "what": "property_roll",
      "why": "Its customer roll: the valuer's roll of each property it supplies is given to it, as valuations are given to a rating authority."
    },
    {
      "what": "acquisition_notice",
      "why": "Its customer roll: each notice that land it supplies has changed hands is given to it."
    }
  ],
  "routines": [
    {
      "task": "draw_water",
      "at": "works",
      "what": "Each day the works draws from the river what the town uses, by the published estimate of how many live in it, and says so when the river cannot give it."
    },
    {
      "task": "bill",
      "at": "works",
      "what": "Before each round of bills a reader goes round the meters; then each property's owner is sent a bill for the service charge and what its meter shows was used. How often the bills go out is the order's."
    }
  ]
}
