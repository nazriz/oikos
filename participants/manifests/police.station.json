{
  "answers": {
    "acts": "What it acts on: a report of a crime, which it investigates; and a request to call at a home where nobody has been seen.",
    "office": "the police station"
  },
  "doc": "docs/behaviour/crime.md",
  "issues": [
    {
      "does": "How the office takes on staff of its own: it puts the posts on the jobs board at the wage given, for people to apply, and the office then offers employment to those it takes on. It commits no money until someone is taken on.",
      "fields": {
        "account": {
          "description": "The account the wages are paid from, where the office itself pays them.",
          "type": "account"
        },
        "period": {
          "description": "The pay period: how often the wage is paid.",
          "required": true,
          "type": "duration"
        },
        "posts": {
          "description": "How many posts this advertisement is for.",
          "required": true,
          "type": "count"
        },
        "wage": {
          "description": "The wage for each pay period.",
          "required": true,
          "type": "amount"
        }
      },
      "form": "job_advertisement",
      "title": "Job advertisement",
      "writes": {
        "data": {
          "industry": "@industry",
          "openings": "=posts",
          "period": "=period",
          "role": "@role",
          "space": "@workplace",
          "wage": "#wage",
          "workplace": "@workplace_structure"
        },
        "kind": "job_posting",
        "offer": {
          "available": "=posts",
          "by": "=self",
          "take_up": "apply",
          "terms": {
            "commitments": [
              {
                "does": {
                  "outcome": {
                    "money": {
                      "amount": "=wage",
                      "for": "wages",
                      "from": "=account"
                    }
                  }
                },
                "every": "=period",
                "who": "=self"
              },
              "@occupancy"
            ],
            "template": "employment",
            "termination": "@termination"
          },
          "to": {
            "min_age_years": 18
          }
        },
        "text": "Hiring: {wage} every {period}."
      }
    },
    {
      "does": "Lays a charge before the tribunal against someone, on a report of a crime and the evidence found.",
      "fields": {
        "account": {
          "description": "The account the victim is to be paid into.",
          "required": true,
          "type": "account"
        },
        "against": {
          "description": "Who is charged.",
          "required": true,
          "type": "entity"
        },
        "amount": {
          "description": "The value of what was taken.",
          "required": true,
          "type": "amount"
        },
        "found": {
          "description": "The evidence: who was found with the goods.",
          "type": "entity"
        },
        "found_at": {
          "description": "The evidence: where.",
          "type": "structure"
        },
        "goods": {
          "description": "The evidence: what goods.",
          "type": "text"
        },
        "report": {
          "description": "The report it comes from.",
          "required": true,
          "type": "record"
        },
        "victim": {
          "description": "Who was wronged.",
          "required": true,
          "type": "entity"
        }
      },
      "form": "charge",
      "title": "A charge laid before the tribunal",
      "writes": {
        "basis": "=report",
        "data": {
          "account": "=account",
          "against": "=against",
          "amount": "#amount",
          "evidence": {
            "at": "=found_at",
            "found": "=found",
            "goods": "=goods"
          },
          "kind": "charge",
          "report": "=report",
          "victim": "=victim"
        },
        "kind": "tribunal_application",
        "sends": [
          {
            "to": [
              "@tribunal"
            ],
            "why": "The tribunal hears the charge."
          }
        ],
        "text": "Charge against {against}, on report {report}.",
        "to": [
          "@tribunal"
        ],
        "visible": [
          "=self",
          "@tribunal",
          "=against"
        ]
      }
    },
    {
      "does": "Tells the registrar of a death the police have found, so that it can be registered.",
      "fields": {
        "deceased": {
          "description": "Who has died.",
          "required": true,
          "type": "entity"
        },
        "found_at": {
          "description": "Where they were found.",
          "type": "space"
        }
      },
      "form": "death_notification",
      "title": "Notification of a death, to the registrar",
      "writes": {
        "data": {
          "deceased": "=deceased",
          "found_at": "=found_at"
        },
        "kind": "death_notification",
        "sends": [
          {
            "to": [
              "@registry"
            ],
            "why": "The registrar registers deaths, on a notification."
          }
        ],
        "text": "Notification of a death: {deceased}.",
        "to": [
          "@registry"
        ]
      }
    },
    {
      "does": "Says, to the tenant and the landlord, that a warrant of the tribunal has been carried out and possession is the landlord's, and how many of the household were there and were put out (none, where nobody was there: possession is given all the same, and nobody was removed). It is the paper of what officers have done at the home, not the doing of it.",
      "fields": {
        "home": {
          "description": "The home.",
          "required": true,
          "type": "space"
        },
        "household": {
          "description": "The household the warrant names.",
          "required": true,
          "type": "list"
        },
        "landlord": {
          "description": "The landlord.",
          "required": true,
          "type": "entity"
        },
        "lease": {
          "description": "The lease.",
          "required": true,
          "type": "record"
        },
        "removed": {
          "description": "How many of the household were there and were put out (nobody there: 0).",
          "required": true,
          "type": "count"
        },
        "tenant": {
          "description": "The tenant.",
          "required": true,
          "type": "entity"
        },
        "warrant": {
          "description": "The warrant.",
          "required": true,
          "type": "record"
        }
      },
      "form": "warrant_executed",
      "title": "A warrant of possession carried out",
      "writes": {
        "basis": "=warrant",
        "data": {
          "household": "=household",
          "lease": "=lease",
          "removed": "=removed",
          "space": "=home",
          "tenant": "=tenant",
          "warrant": "=warrant"
        },
        "kind": "warrant_executed",
        "text": "Warrant {warrant} has been carried out at {home}: of {tenant} and their household, {removed} were there and were put out. Possession is {landlord}'s.",
        "to": [
          "=tenant",
          "=landlord"
        ],
        "visible": [
          "=self",
          "=tenant",
          "=landlord",
          "=household"
        ]
      }
    },
    {
      "does": "Tells the landlord that a warrant ran out before an officer could carry it out, and has lapsed: the landlord may ask the tribunal's registrar for another.",
      "fields": {
        "landlord": {
          "description": "The landlord.",
          "required": true,
          "type": "entity"
        },
        "lease": {
          "description": "The lease.",
          "required": true,
          "type": "record"
        },
        "warrant": {
          "description": "The warrant.",
          "required": true,
          "type": "record"
        }
      },
      "form": "warrant_lapsed",
      "title": "A warrant of possession not carried out in its time",
      "writes": {
        "basis": "=warrant",
        "data": {
          "lease": "=lease",
          "warrant": "=warrant"
        },
        "kind": "warrant_lapsed",
        "text": "Warrant {warrant} was not carried out by its last day, and has lapsed.",
        "to": [
          "=landlord"
        ],
        "visible": [
          "=self",
          "=landlord"
        ]
      }
    },
    {
      "does": "Tells whoever reported a crime that its investigation is closed, and whether it was solved.",
      "fields": {
        "report": {
          "description": "The report.",
          "required": true,
          "type": "record"
        },
        "reporter": {
          "description": "Who reported it.",
          "required": true,
          "type": "entity"
        },
        "solved": {
          "description": "Whether it was solved.",
          "options": [
            "yes",
            "no"
          ],
          "required": true,
          "type": "choice"
        }
      },
      "form": "investigation_closed",
      "title": "An investigation closed",
      "writes": {
        "basis": "=report",
        "data": {
          "report": "=report",
          "solved": "?solved"
        },
        "kind": "investigation_closed",
        "text": "Report {report}: closed; solved {solved}.",
        "to": [
          "=reporter"
        ],
        "visible": [
          "=self",
          "=reporter"
        ]
      }
    }
  ],
