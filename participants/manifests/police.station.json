{
  "name": "police.station",
  "version": "0.6.0",
  "doc": "docs/behaviour/crime.md",
  "params": {
    "account": {
      "schema": {
        "type": "string",
        "description": "what it pays its staff from (its funding comes in there)"
      },
      "default": "",
      "required": true,
      "source": "placeholder"
    },
    "building": {
      "schema": {
        "type": "string",
        "description": "the station, and where its officers work (the world must say)"
      },
      "default": "",
      "required": true,
      "source": "the station, and where its officers work (the world must say)"
    },
    "calls_channel": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "channel": {
      "schema": {
        "type": "string"
      },
      "default": "premises",
      "source": "placeholder"
    },
    "industry": {
      "schema": {
        "type": "string"
      },
      "default": "public_safety",
      "source": "placeholder"
    },
    "look_at": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "look_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 5,
      "source": "placeholder"
    },
    "notice_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 14,
      "source": "placeholder"
    },
    "officers": {
      "schema": {
        "type": "integer",
        "description": "the establishment (its funder's)"
      },
      "default": 0,
      "source": "placeholder"
    },
    "part": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "period": {
      "schema": {
        "type": "integer"
      },
      "default": 1209600,
      "source": "placeholder"
    },
    "registry": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "role": {
      "schema": {
        "type": "string"
      },
      "default": "police officer",
      "source": "placeholder"
    },
    "task": {
      "schema": {
        "type": "string"
      },
      "default": "investigate",
      "source": "placeholder"
    },
    "task_seconds": {
      "schema": {
        "type": "integer"
      },
      "unit": "seconds",
      "default": 14400,
      "source": "placeholder"
    },
    "tribunal": {
      "schema": {
        "type": "string",
        "description": "where charges go"
      },
      "default": "",
      "required": true,
      "source": "placeholder"
    },
    "wage": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "working_day": {
      "schema": {
        "type": "integer"
      },
      "default": 28800,
      "source": "placeholder"
    },
    "workplace": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "required": true,
      "source": "placeholder"
    }
  },
  "perceives": [],
  "state": "none",
  "issues": [
    {
      "form": "job_advertisement",
      "title": "Job advertisement",
      "does": "How the office takes on staff of its own: it puts the posts on the jobs board at the wage given, for people to apply, and the office then offers employment to those it takes on. It commits no money until someone is taken on.",
      "fields": {
        "wage": {
          "type": "amount",
          "required": true,
          "description": "The wage for each pay period."
        },
        "period": {
          "type": "duration",
          "required": true,
          "description": "The pay period: how often the wage is paid."
        },
        "posts": {
          "type": "count",
          "required": true,
          "description": "How many posts this advertisement is for."
        },
        "account": {
          "type": "account",
          "description": "The account the wages are paid from, where the office itself pays them."
        }
      },
      "writes": {
        "kind": "job_posting",
        "text": "Hiring: {wage} every {period}.",
        "data": {
          "wage": "#wage",
          "period": "=period",
          "role": "@role",
          "industry": "@industry",
          "workplace": "@workplace_structure",
          "space": "@workplace"
        },
        "offer": {
          "by": "=self",
          "to": {
            "min_age_years": 18
          },
          "take_up": "apply",
          "available": "=posts",
          "terms": {
            "template": "employment",
            "commitments": [
              {
                "who": "=self",
                "does": {
                  "outcome": {
                    "money": {
                      "from": "=account",
                      "amount": "=wage",
                      "for": "wages"
                    }
                  }
                },
                "every": "=period"
              },
              "@occupancy"
            ],
            "termination": "@termination"
          }
        }
      }
    },
    {
      "form": "charge",
      "title": "A charge laid before the tribunal",
      "does": "Lays a charge before the tribunal against someone, on a report of a crime and the evidence found.",
      "fields": {
        "against": {
          "type": "entity",
          "required": true,
          "description": "Who is charged."
        },
        "victim": {
          "type": "entity",
          "required": true,
          "description": "Who was wronged."
        },
        "report": {
          "type": "record",
          "required": true,
          "description": "The report it comes from."
        },
        "amount": {
          "type": "amount",
          "required": true,
          "description": "The value of what was taken."
        },
        "account": {
          "type": "account",
          "required": true,
          "description": "The account the victim is to be paid into."
        },
        "found": {
          "type": "entity",
          "description": "The evidence: who was found with the goods."
        },
        "found_at": {
          "type": "structure",
          "description": "The evidence: where."
        },
        "goods": {
          "type": "text",
          "description": "The evidence: what goods."
        }
      },
      "writes": {
        "sends": [
          {
            "to": [
              "@tribunal"
            ],
            "why": "The tribunal hears the charge."
          }
        ],
        "kind": "tribunal_application",
        "text": "Charge against {against}, on report {report}.",
        "basis": "=report",
        "to": [
          "@tribunal"
        ],
        "visible": [
          "=self",
          "@tribunal",
          "=against"
        ],
        "data": {
          "kind": "charge",
          "against": "=against",
          "victim": "=victim",
          "report": "=report",
          "amount": "#amount",
          "account": "=account",
          "evidence": {
            "found": "=found",
            "at": "=found_at",
            "goods": "=goods"
          }
        }
      }
    },
    {
      "form": "death_notification",
      "title": "Notification of a death, to the registrar",
      "does": "Tells the registrar of a death the police have found, so that it can be registered.",
      "fields": {
        "deceased": {
          "type": "entity",
          "required": true,
          "description": "Who has died."
        },
        "found_at": {
          "type": "space",
          "description": "Where they were found."
        }
      },
      "writes": {
        "sends": [
          {
            "to": [
              "@registry"
            ],
            "why": "The registrar registers deaths, on a notification."
          }
        ],
        "kind": "death_notification",
        "text": "Notification of a death: {deceased}.",
        "to": [
          "@registry"
        ],
        "data": {
          "deceased": "=deceased",
          "found_at": "=found_at"
        }
      }
    },
    {
      "form": "warrant_executed",
      "title": "A warrant of possession carried out",
      "does": "Says, to the tenant and the landlord, that a warrant of the tribunal has been carried out and possession is the landlord's, and how many of the household were there and were put out (none, where nobody was there: possession is given all the same, and nobody was removed). It is the paper of what officers have done at the home, not the doing of it.",
      "fields": {
        "warrant": {
          "type": "record",
          "required": true,
          "description": "The warrant."
        },
        "lease": {
          "type": "record",
          "required": true,
          "description": "The lease."
        },
        "tenant": {
          "type": "entity",
          "required": true,
          "description": "The tenant."
        },
        "landlord": {
          "type": "entity",
          "required": true,
          "description": "The landlord."
        },
        "home": {
          "type": "space",
          "required": true,
          "description": "The home."
        },
        "household": {
          "type": "list",
          "required": true,
          "description": "The household the warrant names."
        },
        "removed": {
          "type": "count",
          "required": true,
          "description": "How many of the household were there and were put out (nobody there: 0)."
        }
      },
      "writes": {
        "kind": "warrant_executed",
        "text": "Warrant {warrant} has been carried out at {home}: of {tenant} and their household, {removed} were there and were put out. Possession is {landlord}'s.",
        "basis": "=warrant",
        "to": [
          "=tenant",
          "=landlord"
        ],
        "visible": [
          "=self",
          "=tenant",
          "=landlord",
          "=household"
        ],
        "data": {
          "warrant": "=warrant",
          "lease": "=lease",
          "tenant": "=tenant",
          "space": "=home",
          "household": "=household",
          "removed": "=removed"
        }
      }
    },
    {
      "form": "warrant_lapsed",
      "title": "A warrant of possession not carried out in its time",
      "does": "Tells the landlord that a warrant ran out before an officer could carry it out, and has lapsed: the landlord may ask the tribunal's registrar for another.",
      "fields": {
        "warrant": {
          "type": "record",
          "required": true,
          "description": "The warrant."
        },
        "lease": {
          "type": "record",
          "required": true,
          "description": "The lease."
        },
        "landlord": {
          "type": "entity",
          "required": true,
          "description": "The landlord."
        }
      },
      "writes": {
        "kind": "warrant_lapsed",
        "text": "Warrant {warrant} was not carried out by its last day, and has lapsed.",
        "basis": "=warrant",
        "to": [
          "=landlord"
        ],
        "visible": [
          "=self",
          "=landlord"
        ],
        "data": {
          "warrant": "=warrant",
          "lease": "=lease"
        }
      }
    },
    {
      "form": "investigation_closed",
      "title": "An investigation closed",
      "does": "Tells whoever reported a crime that its investigation is closed, and whether it was solved.",
      "fields": {
        "report": {
          "type": "record",
          "required": true,
          "description": "The report."
        },
        "reporter": {
          "type": "entity",
          "required": true,
          "description": "Who reported it."
        },
        "solved": {
          "type": "choice",
          "required": true,
          "options": [
            "yes",
            "no"
          ],
          "description": "Whether it was solved."
        }
      },
      "writes": {
        "kind": "investigation_closed",
        "text": "Report {report}: closed; solved {solved}.",
        "basis": "=report",
        "to": [
          "=reporter"
        ],
        "visible": [
          "=self",
          "=reporter"
        ],
        "data": {
          "report": "=report",
          "solved": "?solved"
        }
      }
    }
  ],
  "routines": [
    {
      "task": "carry_out_warrants",
      "at": "workplace",
      "every": 1,
      "what": "On each working day an officer at the station carries out the tribunal's warrants of possession that have come to it, in the order they came and once the day each gives has come: the officer goes to the home and puts out whoever of the household is there, and the tenant and the landlord are told it is done and how many were there. A warrant its registrar has withdrawn is not gone on; one not carried out by its last day lapses and the landlord is told, and must ask again."
    },
    {
      "task": "look_into_reports",
      "at": "workplace",
      "every": 1,
      "what": "Each working day the officers at the station look into the reports of goods taken that have been made to it, in the order they came, as many as their hours allow (four hours each). Where they find who took them, they lay a charge before the tribunal with what they found as evidence; where they do not, the report is closed unsolved and the person who made it is told."
    },
    {
      "task": "call_at_homes",
      "at": "workplace",
      "every": 1,
      "what": "Each working day an officer goes to each home the station has been asked to call at, where a neighbour has seen nobody come out; if someone is found dead there who is not yet registered as dead, the death is reported to the registry."
    }
  ]
}
