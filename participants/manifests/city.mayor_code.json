{
  "name": "city.mayor_code",
  "version": "0.12.1",
  "doc": "docs/behaviour/government.md",
  "params": {
    "administration_budget": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "budget_lead_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 0,
      "source": "placeholder"
    },
    "builder": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "required": true,
      "source": "placeholder"
    },
    "electoral": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "environment_budget": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "park_budget": {
      "schema": {
        "type": "integer"
      },
      "default": 8000000,
      "source": "placeholder"
    },
    "park_type": {
      "schema": {
        "type": "string"
      },
      "default": "park",
      "source": "placeholder"
    },
    "petition_threshold_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 1500,
      "source": "placeholder"
    },
    "population": {
      "schema": {
        "type": "integer"
      },
      "default": 200,
      "source": "placeholder"
    },
    "responsiveness_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 7000,
      "source": "placeholder"
    },
    "road_budget": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "road_type": {
      "schema": {
        "type": "string"
      },
      "default": "road",
      "source": "placeholder"
    },
    "road_within": {
      "schema": {
        "type": "integer"
      },
      "default": 3,
      "source": "placeholder"
    },
    "services_budget": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "sight_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 30,
      "source": "placeholder"
    },
    "staff_budget": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "stands_again": {
      "schema": {
        "type": "boolean",
        "description": "false: it doesn't stand at the next election (retiring)"
      },
      "default": true,
      "source": "placeholder"
    },
    "visits": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    }
  },
  "perceives": [],
  "state": "none",
  "issues": [
    {
      "form": "invoice_approval",
      "title": "The mayor's written approval of an invoice",
      "fields": {
        "invoice": {
          "type": "record",
          "required": true,
          "description": "The invoice approved for payment."
        }
      },
      "writes": {
        "kind": "approval",
        "text": "Approved for payment: {invoice}.",
        "basis": "=invoice",
        "to": [
          "=self"
        ],
        "data": {
          "invoice": "=invoice"
        }
      }
    },
    {
      "form": "nomination",
      "title": "Nomination for an office at an election",
      "fields": {
        "office": {
          "type": "entity",
          "required": true,
          "description": "The office stood for (the post, by its id)."
        },
        "name": {
          "type": "text",
          "required": true,
          "description": "The name to go on the ballot."
        },
        "platform": {
          "type": "text",
          "required": true,
          "description": "What the candidate puts to the electors."
        },
        "incumbent": {
          "type": "choice",
          "options": [
            "yes",
            "no"
          ],
          "description": "Whether the candidate holds the office now."
        },
        "values": {
          "type": "list",
          "description": "What the candidate stands for, in a word or two each."
        }
      },
      "writes": {
        "sends": [
          {
            "to": [
              "@electoral"
            ],
            "why": "The body that runs the election takes the nominations and puts the names on the ballot paper."
          }
        ],
        "kind": "nomination",
        "text": "Nomination for {office}: {name}. {platform}",
        "to": [
          "@electoral"
        ],
        "visible": "public",
        "assertion": {
          "that": "=platform"
        },
        "data": {
          "office": "=office",
          "name": "=name",
          "incumbent": "?incumbent",
          "values": "=values"
        }
      }
    },
    {
      "form": "petition_response",
      "title": "Answer to a petition",
      "does": "Answers a petition publicly, to its organiser: what has been done about what it asks (put to the council, or not, and why). The answer is written in full on the form (`answer`): what has been done about what the petition asks, or why not, in the mayor's own words; it is the paper's text. It puts nothing to the council by itself: that is the council proposal form, or a law's amendment form.",
      "fields": {
        "petition": {
          "type": "record",
          "required": true,
          "description": "The petition answered."
        },
        "organiser": {
          "type": "entity",
          "description": "Its organiser."
        },
        "answer": {
          "type": "text",
          "required": true,
          "description": "What is answered, in full: what has been done about what the petition asks, or why not."
        }
      },
      "writes": {
        "kind": "petition_response",
        "text": "Answer to petition {petition}: {answer}",
        "basis": "=petition",
        "to": [
          "=organiser"
        ],
        "visible": "public",
        "data": {
          "petition": "=petition",
          "answer": "=answer"
        }
      }
    }
  ]
}
