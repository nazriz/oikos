{
  "name": "city.planning_officer",
  "version": "0.9.0",
  "doc": "docs/behaviour/institutions.md",
  "params": {
    "compliance_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 10000,
      "source": "placeholder"
    },
    "habitat_law": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "town": {
      "schema": {
        "type": "string"
      },
      "default": "e",
      "source": "placeholder"
    }
  },
  "perceives": [],
  "state": "none",
  "issues": [
    {
      "form": "permit_decision",
      "title": "Decision on a planning permit application",
      "does": "Decides a permit application (granted, refused, or sent back as incomplete) and tells the applicant.",
      "fields": {
        "application": {
          "type": "record",
          "required": true,
          "description": "The application decided."
        },
        "applicant": {
          "type": "entity",
          "required": true,
          "description": "Who applied: the decision is sent to them."
        },
        "decision": {
          "type": "choice",
          "required": true,
          "options": [
            "granted",
            "refused",
            "incomplete"
          ],
          "description": "Granted, refused, or sent back as incomplete."
        },
        "law": {
          "type": "record",
          "description": "The law the building would breach, if any."
        },
        "missing": {
          "type": "list",
          "description": "For an incomplete application: what it does not say (lot, structure_type)."
        }
      },
      "writes": {
        "kind": "permit_decision",
        "text": "Permit {decision}: application {application}.",
        "basis": "=application",
        "to": [
          "=applicant"
        ],
        "data": {
          "application": "=application",
          "decision": "=decision",
          "law": "=law",
          "missing": "=missing"
        }
      }
    }
  ]
}
