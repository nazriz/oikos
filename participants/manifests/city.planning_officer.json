{
  "name": "city.planning_officer",
  "version": "0.11.0",
  "doc": "docs/behaviour/institutions.md",
  "params": {
    "automation": {
      "schema": {},
      "default": null,
      "source": "placeholder"
    },
    "casework": {
      "schema": {},
      "default": null,
      "source": "placeholder"
    },
    "compliance_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 10000,
      "source": "placeholder"
    },
    "habitat_law": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "part": {
      "schema": {},
      "source": "the world gives it (no default)"
    },
    "procurement": {
      "schema": {},
      "default": null,
      "source": "placeholder"
    },
    "town": {
      "schema": {
        "type": "string"
      },
      "default": "e",
      "source": "placeholder"
    }
  },
  "perceives": [],
  "state": "none",
  "issues": [
    {
      "form": "permit_decision",
      "title": "Decision on a planning permit application",
      "does": "Decides a permit application (granted, refused, or sent back as incomplete) and tells the applicant. A decision to grant records the permission with it: the applicant's liberty to build that kind of building on that lot, which the building inspector reads. So a grant says the lot and the kind of building, as the application gives them.",
      "fields": {
        "application": {
          "type": "record",
          "required": true,
          "description": "The application decided."
        },
        "applicant": {
          "type": "entity",
          "required": true,
          "description": "Who applied: the decision is sent to them."
        },
        "decision": {
          "type": "choice",
          "required": true,
          "options": [
            "granted",
            "refused",
            "incomplete"
          ],
          "description": "Granted, refused, or sent back as incomplete."
        },
        "lot": {
          "type": "lot",
          "description": "For a grant: the lot the permission is for, as the application names it."
        },
        "structure_type": {
          "type": "structure_type",
          "description": "For a grant: the kind of building permitted, as the application names it."
        },
        "law": {
          "type": "record",
          "description": "The law the building would breach, if any."
        },
        "missing": {
          "type": "list",
          "description": "For an incomplete application: what it does not say (lot, structure_type)."
        },
        "reason": {
          "type": "text",
          "description": "Why it is decided so, in words, where the law named does not say it (a refusal, or what to send in)."
        }
      },
      "writes": {
        "kind": "permit_decision",
        "text": "Permit {decision}: application {application}.",
        "basis": "=application",
        "to": [
          "=applicant"
        ],
        "data": {
          "application": "=application",
          "decision": "=decision",
          "law": "=law",
          "missing": "=missing",
          "reason": "=reason"
        },
        "claim": {
          "when": {
            "decision": "granted"
          },
          "position": "liberty",
          "holder": "=applicant",
          "about": {
            "action": "build",
            "object": "=lot",
            "structure_type": "=structure_type"
          },
          "basis": "=application"
        }
      }
    }
  ]
}
