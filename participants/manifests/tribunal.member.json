{
  "name": "tribunal.member",
  "version": "0.3.0",
  "doc": "docs/behaviour/justice.md",
  "params": {
    "account": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "cases_per_day": {
      "schema": {
        "type": "integer"
      },
      "default": 4,
      "source": "placeholder"
    },
    "fee": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "hearing_after_days": {
      "schema": {
        "type": "integer",
        "description": "listed for a hearing this long after it's made (the respondent's time to answer)"
      },
      "unit": "days",
      "default": 21,
      "source": "placeholder"
    },
    "hears": {
      "schema": {
        "type": "array"
      },
      "default": [],
      "source": "placeholder"
    },
    "part": {
      "schema": {},
      "source": "the world gives it (no default)"
    },
    "pay_within_days": {
      "schema": {
        "type": "integer",
        "description": "an order to pay: within this long"
      },
      "unit": "days",
      "default": 28,
      "source": "placeholder"
    },
    "uphold_bps": {
      "schema": {
        "type": "object"
      },
      "unit": "bps",
      "default": {
        "other": 5000
      },
      "source": "placeholder"
    }
  },
  "perceives": [],
  "state": "none",
  "issues": [
    {
      "form": "tribunal_order",
      "title": "Order of the tribunal on an application",
      "does": "Decides an application before the tribunal and tells both sides: what is found, and for an order to pay, how much, into which account and by when.",
      "fields": {
        "application": {
          "type": "record",
          "required": true,
          "description": "The application decided."
        },
        "kind": {
          "type": "choice",
          "required": true,
          "options": [
            "rent_increase",
            "debt",
            "charge"
          ],
          "description": "What the application was."
        },
        "applicant": {
          "type": "entity",
          "required": true,
          "description": "Who applied."
        },
        "against": {
          "type": "entity",
          "required": true,
          "description": "Whom it was against."
        },
        "finding": {
          "type": "choice",
          "required": true,
          "options": [
            "dismissed",
            "invalid",
            "valid",
            "pay",
            "paid"
          ],
          "description": "What is found."
        },
        "notice": {
          "type": "record",
          "description": "For a rent increase: the notice challenged."
        },
        "laws": {
          "type": "list",
          "description": "The laws the notice breaches, where it is found invalid."
        },
        "claim": {
          "type": "record",
          "description": "For a debt: the claim."
        },
        "amount": {
          "type": "amount",
          "description": "For an order to pay: how much."
        },
        "pay_into": {
          "type": "account",
          "description": "For an order to pay: the account it is paid into."
        },
        "due": {
          "type": "date",
          "description": "For an order to pay: the day it is due by."
        },
        "victim": {
          "type": "entity",
          "description": "For a charge: who was wronged."
        },
        "report": {
          "type": "record",
          "description": "For a charge: the report it came from."
        },
        "paid": {
          "type": "amount",
          "description": "For a debt found paid: how much was paid."
        }
      },
      "writes": {
        "kind": "tribunal_order",
        "text": "Order on {application}: {finding}.",
        "basis": "=application",
        "to": [
          "=applicant",
          "=against"
        ],
        "visible": [
          "=applicant",
          "=against",
          "=self"
        ],
        "data": {
          "application": "=application",
          "kind": "=kind",
          "applicant": "=applicant",
          "against": "=against",
          "finding": "=finding",
          "notice": "=notice",
          "laws": "=laws",
          "claim": "=claim",
          "amount": "#amount",
          "to": "=pay_into",
          "due": "=due",
          "victim": "=victim",
          "report": "=report",
          "paid": "#paid"
        }
      }
    }
  ]
}
