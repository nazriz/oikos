{
  "answers": {
    "acts": "What it acts on: an application for a loan, which it decides by its published terms; and the repayments of the loans it has made.",
    "office": "the bank's lending office"
  },
  "doc": "docs/behaviour/credit.md",
  "issues": [
    {
      "fields": {
        "amount": {
          "description": "Where approved: how much is lent.",
          "type": "amount"
        },
        "applicant": {
          "description": "Who applied.",
          "required": true,
          "type": "entity"
        },
        "application": {
          "description": "The application decided.",
          "required": true,
          "type": "record"
        },
        "approved": {
          "description": "Whether it is approved.",
          "options": [
            "yes",
            "no"
          ],
          "required": true,
          "type": "choice"
        },
        "months": {
          "description": "Where approved: over how many months.",
          "type": "count"
        },
        "payment": {
          "description": "Where approved: the monthly repayment.",
          "type": "amount"
        },
        "rate_bps": {
          "description": "Where approved: the yearly rate, in hundredths of a percent.",
          "type": "count"
        },
        "reason": {
          "description": "Why not, where it is declined.",
          "type": "text"
        }
      },
      "form": "loan_decision",
      "title": "Decision on a loan application",
      "writes": {
        "basis": "=application",
        "data": {
          "amount": "#amount",
          "application": "=application",
          "approved": "?approved",
          "months": "=months",
          "payment": "#payment",
          "rate_bps": "=rate_bps",
          "reason": "=reason"
        },
        "kind": "loan_decision",
        "text": "Loan application {application}: approved {approved}.",
        "to": [
          "=applicant"
        ],
        "visible": [
          "=applicant",
          "=self"
        ]
      }
    },
    {
      "fields": {
        "account": {
          "description": "The account it was paid into.",
          "required": true,
          "type": "account"
        },
        "amount": {
          "description": "How much was paid out.",
          "required": true,
          "type": "amount"
        },
        "borrower": {
          "description": "The borrower.",
          "required": true,
          "type": "entity"
        },
        "loan": {
          "description": "The loan agreement.",
          "required": true,
          "type": "record"
        },
        "request": {
          "description": "The request for the payout.",
          "required": true,
          "type": "record"
        }
      },
      "form": "loan_payout",
      "title": "Advice that a loan has been paid out",
      "writes": {
        "basis": "=request",
        "data": {
          "account": "=account",
          "amount": "#amount",
          "loan": "=loan"
        },
        "kind": "loan_payout",
        "text": "Loan {loan}: {amount} paid out into {account}.",
        "to": [
          "=borrower"
        ],
        "visible": [
          "=borrower",
          "=self"
        ]
      }
    },
    {
      "fields": {
        "account": {
          "description": "The account it is to be paid into.",
          "required": true,
          "type": "account"
        },
        "amount": {
          "description": "How much is drawn.",
          "required": true,
          "type": "amount"
        },
        "rate_bps": {
          "description": "The yearly rate, in hundredths of a percent.",
          "required": true,
          "type": "count"
        }
      },
      "form": "funding_draw",
      "title": "A draw on the bank's wholesale funding",
      "writes": {
        "data": {
          "account": "=account",
          "amount": "#amount",
          "rate_bps": "=rate_bps"
        },
        "kind": "funding_draw",
        "sends": [
          {
            "to": [
              "@funder"
            ],
            "why": "The funder is who the draw is made on: it pays it."
          }
        ],
        "text": "Funding drawn: {amount} into {account}.",
        "to": [
          "@funder"
        ],
        "visible": [
          "=self",
          "@funder"
        ]
      }
    },
    {
      "does": "Tells a borrower in writing that a loan is behind, and by how much. It changes nothing of the loan.",
      "fields": {
        "behind": {
          "description": "How much is behind.",
          "required": true,
          "type": "amount"
        },
        "borrower": {
          "description": "The borrower.",
          "required": true,
          "type": "entity"
        },
        "loan": {
          "description": "The loan agreement.",
          "required": true,
          "type": "record"
        }
      },
      "form": "loan_arrears",
      "title": "Letter to a borrower behind with a loan",
      "writes": {
        "basis": "=loan",
        "data": {
          "behind": "#behind",
          "loan": "=loan"
        },
        "kind": "loan_arrears",
        "text": "Loan {loan}: {behind} behind. Please pay.",
        "to": [
          "=borrower"
        ],
        "visible": [
          "=borrower",
          "=self"
        ]
      }
    },
    {
      "does": "Tells a borrower in writing that a loan is in default: how much is behind and how much is owing in all. It moves nothing by itself.",
      "fields": {
        "behind": {
          "description": "How much is behind.",
          "required": true,
          "type": "amount"
        },
        "borrower": {
          "description": "The borrower.",
          "required": true,
          "type": "entity"
        },
        "loan": {
          "description": "The loan agreement.",
          "required": true,
          "type": "record"
        },
        "outstanding": {
          "description": "How much is owing in all.",
          "required": true,
          "type": "amount"
        }
      },
      "form": "loan_default",
      "title": "Notice to a borrower that a loan is in default",
      "writes": {
        "basis": "=loan",
        "data": {
          "behind": "#behind",
          "loan": "=loan",
          "outstanding": "#outstanding"
        },
        "kind": "loan_default",
        "text": "Loan {loan} is in default: {behind} behind, {outstanding} owing.",
        "to": [
          "=borrower"
        ],
        "visible": [
          "=borrower",
          "=self"
        ]
      }
    }
  ],
  "keeps": [
    {
      "what": "request",
      "why": "The bank's own files: its customers' instructions, among them the repayments of the loans this office made."
    },
    {
      "what": "accounts",
      "why": "The bank's own ledger: it keeps its customers' accounts, and a lending office reads what an applicant holds with it."
    }
  ],
  "name": "bank.lending",
  "params": {
    "arrears_days": {
      "default": 30,
      "schema": {
        "description": "this far behind: arrears (a notice)",
        "type": "integer"
      },
      "source": "placeholder",
      "unit": "days"
    },
    "buffer_bps": {
      "default": 300,
      "schema": {
        "description": "assessed at the rate plus this (serviceability)",
        "type": "integer"
      },
      "source": "placeholder",
      "unit": "bps"
    },
    "default_days": {
      "default": 90,
      "schema": {
        "description": "this far behind: default",
        "type": "integer"
      },
      "source": "placeholder",
      "unit": "days"
    },
    "funding_from": {
      "default": null,
      "schema": {
        "description": "who lends the bank money when it's short (an entity outside)"
      },
      "source": "placeholder"
    },
    "funding_rate_bps": {
      "default": 500,
      "schema": {
        "description": "what that funding costs, a year",
        "type": "integer"
      },
      "source": "placeholder",
      "unit": "bps"
    },
    "max_lvr_bps": {
      "default": 8000,
      "schema": {
        "type": "integer"
      },
      "source": "placeholder",
      "unit": "bps"
    },
    "max_months": {
      "default": 60,
      "schema": {
        "type": "integer"
      },
      "source": "placeholder",
      "unit": "months"
    },
    "max_share_bps": {
      "default": {
        "organisation": 2000,
        "person": 3000
      },
      "schema": {
        "description": "of monthly income, for repayments",
        "type": "object"
      },
      "source": "placeholder",
      "unit": "bps"
    },
    "mortgage_max_months": {
      "default": 360,
      "schema": {
        "type": "integer"
      },
      "source": "placeholder",
      "unit": "months"
    },
    "mortgage_rate_bps": {
      "default": 0,
      "schema": {
        "type": "integer"
      },
      "source": "placeholder",
      "unit": "bps"
    },
    "notice_days": {
      "default": 14,
      "schema": {
        "type": "integer"
      },
      "source": "placeholder",
      "unit": "days"
    },
    "part": {
      "schema": {},
      "source": "the world gives it (no default)"
    },
    "pay_staff": {
      "default": false,
      "schema": {
        "type": "boolean"
      },
      "source": "placeholder"
    },
    "period": {
      "default": 1209600,
      "schema": {
        "type": "integer"
      },
      "source": "placeholder"
    },
    "rate_bps": {
      "default": {
        "organisation": 800,
        "person": 1200
      },
      "schema": {
        "description": "lending rates, a year",
        "type": "object"
      },
      "source": "placeholder",
      "unit": "bps"
    },
    "reserve": {
      "default": 5000000,
      "schema": {
        "description": "kept in the bank's own account, cents",
        "type": "integer"
      },
      "source": "placeholder"
    },
    "who": {
      "default": "",
      "schema": {
        "description": "its channel onto who's who, where it looks up what kind of applicant it has (\"\": it knows what it is shown)",
        "type": "string"
      },
      "source": "placeholder"
    }
  },
  "perceives": [],
  "state": "none",
  "version": "0.6.0"
}
