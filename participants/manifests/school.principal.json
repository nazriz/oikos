{
  "name": "school.principal",
  "version": "0.2.1",
  "doc": "docs/behaviour/education.md",
  "params": {
    "account": {
      "schema": {
        "type": "string",
        "description": "what it pays its staff from (its funding comes in there)"
      },
      "default": "",
      "required": true,
      "source": "placeholder"
    },
    "building": {
      "schema": {
        "type": "string",
        "description": "the school, and where its teachers work (the world must say)"
      },
      "default": "",
      "required": true,
      "source": "the school, and where its teachers work (the world must say)"
    },
    "channel": {
      "schema": {
        "type": "string",
        "description": "its view of the building, who is where in it"
      },
      "default": "premises",
      "source": "placeholder"
    },
    "classrooms": {
      "schema": {
        "type": "array",
        "description": "its classrooms (spaces of the building)"
      },
      "default": [],
      "source": "placeholder"
    },
    "industry": {
      "schema": {
        "type": "string"
      },
      "default": "education",
      "source": "placeholder"
    },
    "lesson_seconds": {
      "schema": {
        "type": "integer"
      },
      "unit": "seconds",
      "default": 21600,
      "source": "placeholder"
    },
    "notice_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 14,
      "source": "placeholder"
    },
    "part": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "period": {
      "schema": {
        "type": "integer"
      },
      "default": 1209600,
      "source": "placeholder"
    },
    "role": {
      "schema": {
        "type": "string"
      },
      "default": "teacher",
      "source": "placeholder"
    },
    "school_ages": {
      "schema": {
        "type": "array",
        "description": "from the year one turns the first, to the end of the year one is the second"
      },
      "default": [
        5,
        17
      ],
      "source": "placeholder"
    },
    "starts": {
      "schema": {
        "type": "integer",
        "description": "when the school day starts (placeholder)"
      },
      "default": 30600,
      "source": "when the school day starts (placeholder)"
    },
    "teach_task": {
      "schema": {
        "type": "string"
      },
      "default": "teach",
      "source": "placeholder"
    },
    "teachers": {
      "schema": {
        "type": "integer",
        "description": "the establishment: how many teachers it keeps (its funder's)"
      },
      "default": 0,
      "source": "placeholder"
    },
    "term_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 70,
      "source": "placeholder"
    },
    "wage": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "working_day": {
      "schema": {
        "type": "integer"
      },
      "default": 28800,
      "source": "placeholder"
    },
    "workplace": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "required": true,
      "source": "placeholder"
    },
    "year": {
      "schema": {
        "type": "integer"
      },
      "default": 31536000,
      "source": "placeholder"
    }
  },
  "perceives": [],
  "state": "none",
  "keeps": [
    {
      "what": "school_enrolment",
      "why": "A school keeps its own roll: every pupil's enrolment is made with it."
    },
    {
      "what": "school_place",
      "why": "The places it has given, each to a pupil on its own roll."
    }
  ],
  "issues": [
    {
      "form": "job_advertisement",
      "title": "Job advertisement",
      "does": "How the office takes on staff of its own: it puts the posts on the jobs board at the wage given, for people to apply, and the office then offers employment to those it takes on. It commits no money until someone is taken on.",
      "fields": {
        "wage": {
          "type": "amount",
          "required": true,
          "description": "The wage for each pay period."
        },
        "period": {
          "type": "duration",
          "required": true,
          "description": "The pay period: how often the wage is paid."
        },
        "posts": {
          "type": "count",
          "required": true,
          "description": "How many posts this advertisement is for."
        },
        "account": {
          "type": "account",
          "description": "The account the wages are paid from, where the office itself pays them."
        }
      },
      "writes": {
        "kind": "job_posting",
        "text": "Hiring: {wage} every {period}.",
        "data": {
          "wage": "#wage",
          "period": "=period",
          "role": "@role",
          "industry": "@industry",
          "workplace": "@workplace_structure",
          "space": "@workplace"
        },
        "offer": {
          "by": "=self",
          "to": {
            "min_age_years": 18
          },
          "take_up": "apply",
          "available": "=posts",
          "terms": {
            "template": "employment",
            "commitments": [
              {
                "who": "=self",
                "does": {
                  "outcome": {
                    "money": {
                      "from": "=account",
                      "amount": "=wage",
                      "for": "wages"
                    }
                  }
                },
                "every": "=period"
              },
              "@occupancy"
            ],
            "termination": "@termination"
          }
        }
      }
    }
  ],
  "routines": [
    {
      "task": "teach",
      "at": "building",
      "what": "Each school day, each classroom with pupils in it is taught by one of the teachers at work."
    },
    {
      "task": "enrol",
      "at": "building",
      "what": "The school office answers each enrolment: a place in the least full classroom for a child of school age, or a letter saying why not; and gives each leaver a certificate of their years."
    }
  ]
}
