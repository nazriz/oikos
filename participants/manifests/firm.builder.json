{
  "name": "firm.builder",
  "version": "0.12.1",
  "doc": "docs/behaviour/institutions.md",
  "params": {
    "build_markup_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 2000,
      "source": "placeholder"
    },
    "horizon_days": {
      "schema": {
        "type": "integer",
        "description": "the crew it wants: enough to do the work in hand within this"
      },
      "unit": "days",
      "default": 90,
      "source": "placeholder"
    },
    "industry": {
      "schema": {
        "type": "string",
        "description": "what the work is (its postings say)"
      },
      "default": "",
      "source": "placeholder"
    },
    "let_go_every_days": {
      "schema": {
        "type": "integer",
        "description": "at most one let go in this time"
      },
      "unit": "days",
      "default": 7,
      "source": "placeholder"
    },
    "look_at": {
      "schema": {},
      "source": "the world gives it (no default)"
    },
    "look_days": {
      "schema": {},
      "unit": "days",
      "source": "the world gives it (no default)"
    },
    "max_crew": {
      "schema": {
        "type": "integer"
      },
      "default": 12,
      "source": "placeholder"
    },
    "min_crew": {
      "schema": {
        "type": "integer",
        "description": "a core crew, kept through quiet times"
      },
      "default": 2,
      "source": "placeholder"
    },
    "notice_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 14,
      "source": "placeholder"
    },
    "notify": {
      "schema": {
        "type": "array"
      },
      "default": [],
      "source": "placeholder"
    },
    "period": {
      "schema": {
        "type": "integer"
      },
      "default": 1209600,
      "source": "placeholder"
    },
    "quote_valid_days": {
      "schema": {
        "type": "integer",
        "description": "a published price is honoured this long (placeholder: a common term for a builder's quote)"
      },
      "unit": "days",
      "default": 30,
      "source": "a published price is honoured this long (placeholder: a common term for a builder's quote)"
    },
    "register": {
      "schema": {},
      "default": null,
      "source": "placeholder"
    },
    "sites": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "supplier": {
      "schema": {
        "type": "string",
        "description": "whom it buys materials from (the world must say)"
      },
      "default": "",
      "required": true,
      "source": "whom it buys materials from (the world must say)"
    },
    "types": {
      "schema": {
        "type": "object"
      },
      "default": {},
      "source": "placeholder"
    },
    "wage": {
      "schema": {
        "type": "integer",
        "description": "the crew's pay, cents per period"
      },
      "default": 150000,
      "source": "placeholder"
    },
    "work_days": {
      "schema": {
        "type": "integer",
        "description": "of every 7 look_at: 0, look_days: 5, // when its staff are in (a time of day on working days: the world's; 0, whenever it wakes)"
      },
      "unit": "days",
      "default": 5,
      "source": "placeholder"
    },
    "working_day": {
      "schema": {
        "type": "integer",
        "description": "seconds a worker works in a day"
      },
      "default": 28800,
      "source": "placeholder"
    },
    "workplace": {
      "schema": {
        "type": "string",
        "description": "the space in the yard its crew works in"
      },
      "default": "",
      "source": "placeholder"
    },
    "yard": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    }
  },
  "perceives": [],
  "state": "none",
  "issues": [
    {
      "form": "job_advertisement",
      "title": "Job advertisement",
      "fields": {
        "wage": {
          "type": "amount",
          "required": true,
          "description": "The wage for each pay period."
        },
        "period": {
          "type": "duration",
          "required": true,
          "description": "The pay period: how often the wage is paid."
        },
        "posts": {
          "type": "count",
          "required": true,
          "description": "How many posts this advertisement is for."
        },
        "account": {
          "type": "account",
          "description": "The account the wages are paid from, where the office itself pays them."
        }
      },
      "writes": {
        "kind": "job_posting",
        "text": "Hiring: {wage} every {period}.",
        "data": {
          "wage": "#wage",
          "period": "=period",
          "role": "@role",
          "industry": "@industry",
          "workplace": "@workplace_structure",
          "space": "@workplace"
        },
        "offer": {
          "by": "=self",
          "to": {
            "min_age_years": 18
          },
          "take_up": "apply",
          "available": "=posts",
          "terms": {
            "template": "employment",
            "commitments": [
              {
                "who": "=self",
                "does": {
                  "outcome": {
                    "money": {
                      "from": "=account",
                      "amount": "=wage",
                      "for": "wages"
                    }
                  }
                },
                "every": "=period"
              },
              "@occupancy"
            ],
            "termination": "@termination"
          }
        }
      }
    }
  ]
}
