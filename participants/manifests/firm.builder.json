{
  "answers": {
    "acts": "What it acts on: a construction agreement signed with it, built once a permit for the site is in force and invoiced as agreed. Its prices are published.",
    "office": "the builder's office",
    "report": true
  },
  "doc": "docs/behaviour/institutions.md",
  "issues": [
    {
      "does": "How the office takes on staff of its own: it puts the posts on the jobs board at the wage given, for people to apply, and the office then offers employment to those it takes on. It commits no money until someone is taken on.",
      "fields": {
        "account": {
          "description": "The account the wages are paid from, where the office itself pays them.",
          "type": "account"
        },
        "period": {
          "description": "The pay period: how often the wage is paid.",
          "required": true,
          "type": "duration"
        },
        "posts": {
          "description": "How many posts this advertisement is for.",
          "required": true,
          "type": "count"
        },
        "wage": {
          "description": "The wage for each pay period.",
          "required": true,
          "type": "amount"
        }
      },
      "form": "job_advertisement",
      "title": "Job advertisement",
      "writes": {
        "data": {
          "industry": "@industry",
          "openings": "=posts",
          "period": "=period",
          "role": "@role",
          "space": "@workplace",
          "wage": "#wage",
          "workplace": "@workplace_structure"
        },
        "kind": "job_posting",
        "offer": {
          "available": "=posts",
          "by": "=self",
          "take_up": "apply",
          "terms": {
            "commitments": [
              {
                "does": {
                  "outcome": {
                    "money": {
                      "amount": "=wage",
                      "for": "wages",
                      "from": "=account"
                    }
                  }
                },
                "every": "=period",
                "who": "=self"
              },
              "@occupancy"
            ],
            "template": "employment",
            "termination": "@termination"
          },
          "to": {
            "min_age_years": 18
          }
        },
        "text": "Hiring: {wage} every {period}."
      }
    },
    {
      "does": "How the office buys from a supplier, the outside world's market among them: it places the order at the seller's listed price. The form pays nothing by itself: pay the whole sum into the account the seller's price list names, at the same sitting. The seller delivers once an order is paid in full, sends back money that comes with no order waiting for it, and declines an order unpaid after a week.",
      "fields": {
        "account": {
          "description": "The account the order is paid from.",
          "required": true,
          "type": "account"
        },
        "at": {
          "description": "Where they are to be delivered.",
          "required": true,
          "type": "structure"
        },
        "deliver_to": {
          "description": "Who is to receive them.",
          "required": true,
          "type": "entity"
        },
        "for_days": {
          "description": "How many days the order may be served over.",
          "type": "count"
        },
        "kind": {
          "description": "What is ordered.",
          "required": true,
          "type": "text"
        },
        "quantity": {
          "description": "How many.",
          "required": true,
          "type": "count"
        },
        "retry_of": {
          "description": "An earlier order this one repeats.",
          "type": "record"
        },
        "seller": {
          "description": "Whom it is ordered from.",
          "required": true,
          "type": "entity"
        },
        "unit_price": {
          "description": "The price of each, as the seller advertises it.",
          "required": true,
          "type": "amount"
        }
      },
      "form": "order",
      "title": "An order to a supplier, paid with the order",
      "writes": {
        "data": {
          "account": "=account",
          "at": "=at",
          "deliver_to": "=deliver_to",
          "for_days": "=for_days",
          "kind": "=kind",
          "quantity": "=quantity",
          "retry_of": "=retry_of",
          "unit_price": "#unit_price"
        },
        "kind": "order",
        "text": "Order: {quantity} {kind} at {unit_price} each, delivered to {deliver_to} at {at}. Paid with this order.",
        "to": [
          "=seller"
        ],
        "visible": [
          "=self",
          "=seller"
        ]
      }
    }
  ],
