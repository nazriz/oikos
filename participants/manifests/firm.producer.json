        },
        "wrong": {
          "description": "For a paper complained of: whether it was wrong.",
          "options": [
            "yes",
            "no"
          ],
          "type": "choice"
        }
      },
      "form": "tribunal_answer",
      "title": "Answer to the tribunal's notice of an application against the office",
      "writes": {
        "basis": "=application",
        "data": {
          "application": "=application",
          "done": "?done",
          "known": "?known",
          "owed": "#owed",
          "statement": "=statement",
          "wrong": "?wrong"
        },
        "kind": "tribunal_response",
        "text": "Answer on {application}.",
        "to": [
          "=venue"
        ],
        "visible": [
          "=venue",
          "=self",
          "=applicant"
        ]
      }
    }
  ],
