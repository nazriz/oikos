{
  "name": "firm.producer",
  "version": "0.4.4",
  "doc": "docs/behaviour/producer.md",
  "params": {
    "builder": {
      "schema": {
        "type": "string",
        "description": "whose published prices say what our premises are worth (none: closed, they're not sold)"
      },
      "default": "",
      "source": "placeholder"
    },
    "casual_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 0,
      "source": "placeholder"
    },
    "chi_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 1000,
      "source": "placeholder"
    },
    "day_wage": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "delta_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 190,
      "source": "placeholder"
    },
    "gamma_months": {
      "schema": {
        "type": "integer"
      },
      "unit": "months",
      "default": 24,
      "source": "placeholder"
    },
    "idle_days": {
      "schema": {
        "type": "integer",
        "description": "nobody working for us this long, our owners close us (placeholder)"
      },
      "unit": "days",
      "default": 90,
      "source": "nobody working for us this long, our owners close us (placeholder)"
    },
    "industry": {
      "schema": {
        "type": "string",
        "description": "what the work is (its postings say)"
      },
      "default": "",
      "source": "placeholder"
    },
    "labour_per_unit": {
      "schema": {
        "type": "integer",
        "description": "seconds of work per unit"
      },
      "default": 5400,
      "source": "placeholder"
    },
    "lender": {
      "schema": {
        "type": "string",
        "description": "whom it borrows from (none: it doesn't)"
      },
      "default": "",
      "source": "placeholder"
    },
    "look_at": {
      "schema": {},
      "source": "the world gives it (no default)"
    },
    "look_days": {
      "schema": {},
      "unit": "days",
      "source": "the world gives it (no default)"
    },
    "market": {
      "schema": {
        "type": "string",
        "description": "whom it exports to, under its buying offer (the world must say)"
      },
      "default": "",
      "required": true,
      "source": "whom it exports to, under its buying offer (the world must say)"
    },
    "max_staff": {
      "schema": {
        "type": "integer"
      },
      "default": 40,
      "source": "placeholder"
    },
    "min_order": {
      "schema": {
        "type": "integer",
        "description": "the least it sells in one order (it sells wholesale)"
      },
      "default": 50,
      "source": "placeholder"
    },
    "notice_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 14,
      "source": "placeholder"
    },
    "output": {
      "schema": {
        "type": "string"
      },
      "default": "goods",
      "source": "placeholder"
    },
    "per_unit": {
      "schema": {
        "type": "object",
        "description": "what a unit of the task uses (its own knowledge of its process)"
      },
      "default": {
        "inputs": 10
      },
      "source": "placeholder"
    },
    "period": {
      "schema": {
        "type": "integer"
      },
      "default": 1209600,
      "source": "placeholder"
    },
    "phi_high_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 10000,
      "source": "placeholder"
    },
    "phi_low_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 2500,
      "source": "placeholder"
    },
    "premises_sale_bps": {
      "schema": {
        "type": "integer",
        "description": "closed, our premises are offered at this share of what building them new costs (placeholder)"
      },
      "unit": "bps",
      "default": 5000,
      "source": "closed, our premises are offered at this share of what building them new costs (placeholder)"
    },
    "price": {
      "schema": {
        "type": "integer",
        "description": "its wholesale price, cents each"
      },
      "default": 6000,
      "source": "placeholder"
    },
    "price_down_bound_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 10250,
      "source": "placeholder"
    },
    "price_up_bound_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 11500,
      "source": "placeholder"
    },
    "registered_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 10000,
      "source": "placeholder"
    },
    "reprice_bps": {
      "schema": {
        "type": "integer",
        "description": "by this much (placeholder)"
      },
      "unit": "bps",
      "default": 1000,
      "source": "by this much (placeholder)"
    },
    "reprice_days": {
      "schema": {
        "type": "integer",
        "description": "closed, our premises unsold this long: the asking price comes down (placeholder)"
      },
      "unit": "days",
      "default": 30,
      "source": "closed, our premises unsold this long: the asking price comes down (placeholder)"
    },
    "role": {
      "schema": {
        "type": "string"
      },
      "default": "factory worker",
      "source": "placeholder"
    },
    "short_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 60,
      "source": "placeholder"
    },
    "supplier": {
      "schema": {
        "type": "string",
        "description": "whom it buys inputs from (the world must say)"
      },
      "default": "",
      "required": true,
      "source": "whom it buys inputs from (the world must say)"
    },
    "task": {
      "schema": {
        "type": "string"
      },
      "default": "make",
      "source": "placeholder"
    },
    "theta_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 7500,
      "source": "placeholder"
    },
    "vartheta_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 200,
      "source": "placeholder"
    },
    "wage": {
      "schema": {
        "type": "integer",
        "description": "the wage it offers new hires, cents per period"
      },
      "default": 150000,
      "source": "placeholder"
    },
    "wind_up_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 60,
      "source": "placeholder"
    },
    "work_days": {
      "schema": {
        "type": "integer",
        "description": "of every 7 look_at: 0, look_days: 5, // when its staff are in (a time of day on working days: the world's; 0, whenever it wakes)"
      },
      "unit": "days",
      "default": 5,
      "source": "placeholder"
    },
    "working_day": {
      "schema": {
        "type": "integer"
      },
      "default": 28800,
      "source": "placeholder"
    },
    "workplace": {
      "schema": {
        "type": "string",
        "description": "the space its workers work in"
      },
      "default": "",
      "source": "placeholder"
    },
    "works": {
      "schema": {
        "type": "string",
        "description": "the factory: where it makes and keeps things"
      },
      "default": "",
      "source": "placeholder"
    }
  },
  "perceives": [],
  "state": "none",
  "issues": [
    {
      "form": "job_advertisement",
      "title": "Job advertisement",
      "does": "How the office takes on staff of its own: it puts the posts on the jobs board at the wage given, for people to apply, and the office then offers employment to those it takes on. It commits no money until someone is taken on.",
      "fields": {
        "wage": {
          "type": "amount",
          "required": true,
          "description": "The wage for each pay period."
        },
        "period": {
          "type": "duration",
          "required": true,
          "description": "The pay period: how often the wage is paid."
        },
        "posts": {
          "type": "count",
          "required": true,
          "description": "How many posts this advertisement is for."
        },
        "account": {
          "type": "account",
          "description": "The account the wages are paid from, where the office itself pays them."
        }
      },
      "writes": {
        "kind": "job_posting",
        "text": "Hiring: {wage} every {period}.",
        "data": {
          "wage": "#wage",
          "period": "=period",
          "role": "@role",
          "industry": "@industry",
          "workplace": "@workplace_structure",
          "space": "@workplace"
        },
        "offer": {
          "by": "=self",
          "to": {
            "min_age_years": 18
          },
          "take_up": "apply",
          "available": "=posts",
          "terms": {
            "template": "employment",
            "commitments": [
              {
                "who": "=self",
                "does": {
                  "outcome": {
                    "money": {
                      "from": "=account",
                      "amount": "=wage",
                      "for": "wages"
                    }
                  }
                },
                "every": "=period"
              },
              "@occupancy"
            ],
            "termination": "@termination"
          }
        }
      }
    },
    {
      "form": "order",
      "title": "An order to a supplier, paid with the order",
      "does": "How the office buys from a supplier, the outside world's market among them: it places the order at the seller's listed price. The form pays nothing by itself: pay the whole sum into the account the seller's price list names, at the same sitting. The seller delivers once an order is paid in full, sends back money that comes with no order waiting for it, and declines an order unpaid after a week.",
      "fields": {
        "seller": {
          "type": "entity",
          "required": true,
          "description": "Whom it is ordered from."
        },
        "kind": {
          "type": "text",
          "required": true,
          "description": "What is ordered."
        },
        "quantity": {
          "type": "count",
          "required": true,
          "description": "How many."
        },
        "unit_price": {
          "type": "amount",
          "required": true,
          "description": "The price of each, as the seller advertises it."
        },
        "deliver_to": {
          "type": "entity",
          "required": true,
          "description": "Who is to receive them."
        },
        "at": {
          "type": "structure",
          "required": true,
          "description": "Where they are to be delivered."
        },
        "account": {
          "type": "account",
          "required": true,
          "description": "The account the order is paid from."
        },
        "retry_of": {
          "type": "record",
          "description": "An earlier order this one repeats."
        },
        "for_days": {
          "type": "count",
          "description": "How many days the order may be served over."
        }
      },
      "writes": {
        "kind": "order",
        "text": "Order: {quantity} {kind} at {unit_price} each, delivered to {deliver_to} at {at}. Paid with this order.",
        "to": [
          "=seller"
        ],
        "visible": [
          "=self",
          "=seller"
        ],
        "data": {
          "kind": "=kind",
          "quantity": "=quantity",
          "unit_price": "#unit_price",
          "deliver_to": "=deliver_to",
          "at": "=at",
          "account": "=account",
          "retry_of": "=retry_of",
          "for_days": "=for_days"
        }
      }
    },
    {
      "form": "delivery_note",
      "title": "A delivery note for an order served",
      "fields": {
        "order": {
          "type": "record",
          "required": true,
          "description": "The order."
        },
        "buyer": {
          "type": "entity",
          "required": true,
          "description": "Who ordered."
        },
        "kind": {
          "type": "text",
          "required": true,
          "description": "What was ordered."
        },
        "ordered": {
          "type": "count",
          "required": true,
          "description": "How many were ordered."
        },
        "delivered": {
          "type": "count",
          "required": true,
          "description": "How many were delivered."
        },
        "refund": {
          "type": "amount",
          "required": true,
          "description": "What was refunded for those not delivered."
        },
        "declined": {
          "type": "choice",
          "options": [
            "unpaid"
          ],
          "description": "Where nothing was delivered because it was not paid for."
        }
      },
      "writes": {
        "kind": "delivery_note",
        "text": "Delivered: {delivered} of {ordered} {kind} (order {order}).",
        "basis": "=order",
        "to": [
          "=buyer"
        ],
        "visible": [
          "=buyer",
          "=self"
        ],
        "data": {
          "order": "=order",
          "kind": "=kind",
          "ordered": "=ordered",
          "delivered": "=delivered",
          "refund": "#refund",
          "declined": "=declined"
        }
      }
    },
    {
      "form": "wage_offer",
      "title": "An answer to a union's wage claim",
      "fields": {
        "union": {
          "type": "entity",
          "required": true,
          "description": "The union that made the claim."
        },
        "claim": {
          "type": "record",
          "required": true,
          "description": "The claim answered."
        },
        "rise_bps": {
          "type": "count",
          "required": true,
          "description": "The rise offered, in hundredths of a percent."
        },
        "why": {
          "type": "text",
          "description": "Why that much."
        }
      },
      "writes": {
        "kind": "wage_offer",
        "text": "We offer a rise of {rise_bps} hundredths of a percent, in answer to {claim}.",
        "basis": "=claim",
        "to": [
          "=union"
        ],
        "visible": [
          "=self",
          "=union"
        ],
        "data": {
          "employer": "=self",
          "claim": "=claim",
          "rise_bps": "=rise_bps",
          "why": "=why"
        }
      }
    },
    {
      "form": "export_invoice",
      "title": "An invoice for goods sent to a buyer",
      "fields": {
        "buyer": {
          "type": "entity",
          "required": true,
          "description": "Who is invoiced."
        },
        "offer": {
          "type": "record",
          "description": "The buyer's standing offer it is sent under."
        },
        "kind": {
          "type": "text",
          "required": true,
          "description": "What was sent."
        },
        "quantity": {
          "type": "count",
          "required": true,
          "description": "How many."
        },
        "from_at": {
          "type": "structure",
          "required": true,
          "description": "Where they were sent from."
        },
        "amount": {
          "type": "amount",
          "required": true,
          "description": "The sum invoiced."
        },
        "account": {
          "type": "account",
          "required": true,
          "description": "The account it is to be paid into."
        },
        "memo": {
          "type": "text",
          "required": true,
          "description": "What the payment is for, in a few words."
        }
      },
      "writes": {
        "kind": "invoice",
        "text": "Invoice: {quantity} {kind}, {amount}.",
        "basis": "=offer",
        "to": [
          "=buyer"
        ],
        "visible": [
          "=self",
          "=buyer"
        ],
        "data": {
          "kind": "=kind",
          "quantity": "=quantity",
          "from_at": "=from_at",
          "outcome": {
            "money": {
              "to": "=account",
              "amount": "=amount",
              "for": "=memo"
            }
          }
        }
      }
    },
    {
      "form": "crime_report",
      "title": "A report of goods taken, to the police",
      "fields": {
        "kind": {
          "type": "text",
          "required": true,
          "description": "What was taken."
        },
        "quantity": {
          "type": "count",
          "required": true,
          "description": "How many."
        },
        "at": {
          "type": "structure",
          "required": true,
          "description": "Where from."
        },
        "value": {
          "type": "amount",
          "required": true,
          "description": "What it was worth."
        },
        "account": {
          "type": "account",
          "required": true,
          "description": "The account to be paid into if it is recovered."
        }
      },
      "writes": {
        "kind": "crime_report",
        "text": "Report: {quantity} {kind} taken from {at}.",
        "to": [
          "@police"
        ],
        "visible": [
          "=self",
          "@police"
        ],
        "data": {
          "kind": "=kind",
          "quantity": "=quantity",
          "at": "=at",
          "value": "#value",
          "account": "=account"
        }
      }
    }
  ]
}
