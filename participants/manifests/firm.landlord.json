    {
      "form": "rental_listing",
      "title": "A home advertised to let",
      "fields": {
        "structure": {
          "type": "structure",
          "required": true,
          "description": "The building."
        },
        "space": {
          "type": "space",
          "required": true,
          "description": "The home in it."
        },
        "type": {
          "type": "structure_type",
          "required": true,
          "description": "The kind of building."
        },
        "rent": {
          "type": "amount",
          "required": true,
          "description": "The rent a month."
        },
        "account": {
          "type": "account",
          "required": true,
          "description": "The account the rent is paid into."
        },
        "bedrooms": {
          "type": "count",
          "description": "How many bedrooms."
        },
        "then": {
          "type": "choice",
          "options": [
            "periodic"
          ],
          "description": "What follows the lease's term: periodic, if it continues until ended by notice."
        }
      },
      "writes": {
        "kind": "rental_listing",
        "text": "To let: {space}, {rent} a month.",
        "data": {
          "structure": "=structure",
          "space": "=space",
          "type": "=type",
          "bedrooms": "=bedrooms",
          "rent": "#rent"
        },
        "offer": {
          "by": "=self",
          "take_up": "apply",
          "available": 1,
          "terms": {
            "template": "lease",
            "then": "=then",
            "commitments": [
              {
                "who": "=self",
                "does": {
                  "outcome": {
                    "occupancy": {
                      "in": "=space"
                    }
                  }
                }
              },
              {
                "who": "taker",
                "does": {
                  "outcome": {
                    "money": {
                      "to": "=account",
                      "amount": "=rent",
                      "for": "rent"
                    }
                  }
                },
                "every": 2592000
              }
            ]
          }
        }
      }
    },
    {
      "form": "rent_increase",
      "title": "Notice of a rent increase",
      "fields": {
        "lease": {
          "type": "record",
          "required": true,
          "description": "The lease."
        },
        "tenant": {
          "type": "entity",
          "required": true,
          "description": "The tenant."
        },
        "rent": {
          "type": "amount",
          "required": true,
          "description": "The new rent a month."
        },
        "was": {
          "type": "amount",
          "required": true,
          "description": "The rent now."
        },
        "from": {
          "type": "date",
          "required": true,
          "description": "The day the new rent starts."
        },
        "last_from": {
          "type": "date",
          "required": true,
          "description": "The day the rent now paid started."
        }
      },
      "writes": {
        "kind": "rent_increase",
        "text": "Notice of rent increase: {rent} a month from {from} (now {was}).",
        "basis": "=lease",
        "to": [
          "=tenant"
        ],
        "visible": [
          "=self",
          "=tenant"
        ],
        "data": {
          "lease": "=lease",
          "rent": "#rent",
          "from": "=from",
          "was": "#was",
          "last_from": "=last_from"
        }
      }
    },
    {
      "form": "tax_report",
      "title": "Return of rent received, to the town",
      "fields": {
        "rent_received": {
          "type": "amount",
          "required": true,
          "description": "The rent received in the period."
        },
        "account": {
          "type": "account",
          "required": true,
          "description": "The account it was received into."
        },
        "period_end": {
          "type": "date",
          "required": true,
          "description": "The day the period ended."
        }
      },
      "writes": {
        "sends": [
          {
            "to": [
              "@city"
            ],
            "why": "The return is made to the town, which the rent is reported to."
          }
        ],
        "kind": "tax_report",
        "text": "Rent received this month: {rent_received}.",
        "to": [
          "@city"
        ],
        "data": {
          "period_end": "=period_end",
          "rent_received": "#rent_received",
          "account": "=account"
        }
      }
    },
    {
      "form": "death_notification",
      "title": "Notification of a death, to the registrar",
      "fields": {
        "deceased": {
          "type": "entity",
          "required": true,
          "description": "Who has died."
        }
      },
      "writes": {
        "sends": [
          {
            "to": [
              "@city"
            ],
            "why": "The town's registrar registers deaths, on a notification."
          }
        ],
        "kind": "death_notification",
        "text": "Notification of a death: {deceased}.",
        "to": [
          "@city"
        ],
        "data": {
          "deceased": "=deceased"
        }
      }
    },
    {
      "form": "rent_reminder",
      "title": "Request to a tenant for rent owed",
      "does": "Asks a tenant in writing for rent that is owed, with the sum and the account. It ends nothing and moves no money.",
      "fields": {
        "tenant": {
          "type": "entity",
          "required": true,
          "description": "The tenant."
        },
        "lease": {
          "type": "record",
          "required": true,
          "description": "The lease."
        },
        "amount": {
          "type": "amount",
          "required": true,
          "description": "How much is owed."
        },
        "account": {
          "type": "account",
          "description": "The account it is to be paid into."
        }
      },
      "writes": {
        "kind": "review_request",
        "text": "Request: the rent for your home is {amount} in arrears. Please pay it.",
        "basis": "=lease",
        "to": [
          "=tenant"
        ],
        "visible": [
          "=self",
          "=tenant"
        ],
        "data": {
          "matter": "arrears",
          "against": "=tenant",
          "about": "=lease",
          "amount": "#amount",
          "account": "=account"
        }
      }
    },
    {
      "form": "payment_plan_offer",
      "title": "Offer to a tenant of a plan to pay rent owed",
      "does": "Offers a tenant behind with the rent a plan: the rent as it falls due, and a sum a month toward what is owed. The tenant answers on the offer whether the household can pay it, and what it could pay. It ends nothing and binds nobody: a plan agreed is kept, or not, by the tenant's payments.",
      "fields": {
        "tenant": {
          "type": "entity",
          "required": true,
          "description": "The tenant."
        },
        "lease": {
          "type": "record",
          "required": true,
          "description": "The lease."
        },
        "owed": {
          "type": "amount",
          "required": true,
          "description": "How much is owed."
        },
        "instalment": {
          "type": "amount",
          "required": true,
          "description": "The sum a month toward what is owed, beyond the rent."
        },
        "account": {
          "type": "account",
          "description": "The account it is to be paid into."
        }
      },
      "writes": {
        "kind": "plan_offer",
        "text": "Offer of a plan: pay the rent as it falls due and {instalment} a month toward the {owed} owed under {lease}. Please answer whether you can.",
        "basis": "=lease",
        "to": [
          "=tenant"
        ],
        "visible": [
          "=self",
          "=tenant"
        ],
        "data": {
          "lease": "=lease",
          "owed": "#owed",
          "instalment": "#instalment",
          "account": "=account"
        }
      }
    },
    {
      "form": "arrears_application",
      "title": "Application for an order that a tenant pay rent owed",
      "does": "Applies to a body that says it hears rent in arrears (its notice of what it hears, and what applying costs, is public) for an order that the tenant pay. The body tells the tenant, gives them time to answer and decides. A fee, where the body has one, is paid with it, by a payment. It ends no tenancy.",
      "fields": {
        "venue": {
          "type": "entity",
          "required": true,
          "description": "The body applied to."
        },
        "hearing": {
          "type": "record",
          "description": "Its notice of what it hears."
        },
        "tenant": {
          "type": "entity",
          "required": true,
          "description": "The tenant."
        },
        "lease": {
          "type": "record",
          "required": true,
          "description": "The lease."
        },
        "amount": {
          "type": "amount",
          "required": true,
          "description": "How much is owed."
        },
        "account": {
          "type": "account",
          "required": true,
          "description": "The account it is to be paid into."
        }
      },
      "writes": {
        "kind": "tribunal_application",
        "text": "Application: {tenant} owes us {amount} in rent under {lease}.",
        "basis": "=hearing",
        "to": [
          "=venue"
        ],
        "visible": [
          "=self",
          "=venue",
          "=tenant"
        ],
        "data": {
          "kind": "arrears",
          "matter": "arrears",
          "against": "=tenant",
          "about": "=lease",
          "amount": "#amount",
          "account": "=account",
          "evidence": {
            "id": "=lease",
            "record": "agreement"
          }
        }
      }
    },
    {
      "form": "notice_to_vacate",
      "title": "Notice to a tenant to vacate for rent owed",
      "does": "Gives a tenant written notice to leave the home by a day, for rent owed. It ends nothing by itself and puts nobody out: if the rent owed is paid before the day the notice is spent (withdraw it); if the tenant is still there after the day, the landlord may apply to the tribunal for possession. How long rent must have been owed before it may be given, and how many days it must run, are in the law on possession. A notice is given when it is on the record, addressed to the tenant: that is how papers are served here.",
      "fields": {
        "tenant": {
          "type": "entity",
          "required": true,
          "description": "The tenant."
        },
        "lease": {
          "type": "record",
          "required": true,
          "description": "The lease."
        },
        "arrears": {
          "type": "amount",
          "required": true,
          "description": "The rent owed."
        },
        "by": {
          "type": "date",
          "required": true,
          "description": "The day the tenant is to leave by."
        },
        "law": {
          "type": "record",
          "description": "The law the notice is given under."
        }
      },
      "writes": {
        "kind": "notice_to_vacate",
        "text": "Notice to vacate: the rent under {lease} is {arrears} in arrears. You are to leave the home by {by}. If the arrears are paid before then, this notice lapses. If you are still there after it, we may apply to the tribunal for possession.",
        "basis": "=lease",
        "to": [
          "=tenant"
        ],
        "visible": [
          "=self",
          "=tenant"
        ],
        "data": {
          "lease": "=lease",
          "reason": "arrears",
          "arrears": "#arrears",
          "by": "=by",
          "law": "=law"
        }
      }
    },
    {
      "form": "possession_application",
      "title": "Application to the tribunal for possession of a let home",
      "does": "Applies to the tribunal for possession of a home whose tenant is behind with the rent and has not left on a notice to vacate that has run out. It states the lease, the rent, what is owed, the home and who lives there by the lease, and the notice relied on: which paper, the day it was given and the day it gave. The tribunal tells the tenant, who may answer, and decides: a plan to pay, possession on a day, or dismissal. The tribunal's fee, where it has one, is paid with it, by a payment. It ends no tenancy and puts nobody out.",
      "fields": {
        "tenant": {
          "type": "entity",
          "required": true,
          "description": "The tenant."
        },
        "lease": {
          "type": "record",
          "required": true,
          "description": "The lease."
        },
        "owed": {
          "type": "amount",
          "required": true,
          "description": "The rent owed."
        },
        "rent": {
          "type": "amount",
          "description": "The rent a month."
        },
        "account": {
          "type": "account",
          "description": "The account rent is paid into."
        },
        "home": {
          "type": "space",
          "description": "The home."
        },
        "building": {
          "type": "structure",
          "description": "The building it is in."
        },
        "household": {
          "type": "list",
          "description": "Who lives there by the lease: the tenant first."
        },
        "notice": {
          "type": "record",
          "description": "The notice to vacate relied on."
        },
        "notice_given": {
          "type": "date",
          "description": "The day that notice was given."
        },
        "notice_by": {
          "type": "date",
          "description": "The day that notice gave to leave by."
        },
        "plan_broken": {
          "type": "choice",
          "options": [
            "yes",
            "no"
          ],
          "description": "Yes, where the tribunal set a plan to pay and it has not been kept."
        }
      },
      "writes": {
        "sends": [
          {
            "to": [
              "@tribunal"
            ],
            "why": "The tribunal hears applications for possession."
          }
        ],
        "kind": "tribunal_application",
        "text": "Application for possession: {tenant} is {owed} behind with the rent under {lease} and has not left on our notice to vacate.",
        "basis": "=lease",
        "to": [
          "@tribunal"
        ],
        "visible": [
          "=self",
          "@tribunal",
          "=tenant"
        ],
        "data": {
          "kind": "possession",
          "matter": "possession",
          "against": "=tenant",
          "about": "=lease",
          "amount": "#owed",
          "rent": "#rent",
          "account": "=account",
          "breach": "?plan_broken",
          "space": "=home",
          "structure": "=building",
          "household": "=household",
          "notice": "=notice",
          "notice_given": "=notice_given",
          "notice_by": "=notice_by",
          "evidence": {
            "id": "=lease",
            "record": "agreement"
          }
        }
      }
    },
    {
      "form": "possession_reply",
      "title": "Reply to a tenant's answer to an application for possession",
      "does": "Replies to what a tenant has answered the tribunal on an application of this office's for possession: what the rent book shows owed on the day of the reply, and whether a plan the tenant offers would be taken. It goes to the tribunal, for the member who decides, and to the tenant. It withdraws nothing and decides nothing.",
      "fields": {
        "application": {
          "type": "record",
          "required": true,
          "description": "The application for possession."
        },
        "tenant": {
          "type": "entity",
          "required": true,
          "description": "The tenant."
        },
        "owed": {
          "type": "amount",
          "required": true,
          "description": "What the rent book shows owed on the day of this reply."
        },
        "takes_plan": {
          "type": "choice",
          "options": [
            "yes",
            "no"
          ],
          "description": "Whether the plan the tenant offers would be taken."
        },
        "words": {
          "type": "text",
          "description": "Anything else for the tribunal, in words."
        }
      },
      "writes": {
        "sends": [
          {
            "to": [
              "@tribunal"
            ],
            "why": "The tribunal's member decides the application, on what both sides have said."
          }
        ],
        "kind": "tribunal_reply",
        "text": "Reply on application {application}: our rent book shows {owed} owed by {tenant} today.",
        "basis": "=application",
        "to": [
          "@tribunal",
          "=tenant"
        ],
        "visible": [
          "=self",
          "@tribunal",
          "=tenant"
        ],
        "data": {
          "application": "=application",
          "against": "=tenant",
          "owed": "#owed",
          "takes_plan": "?takes_plan",
          "words": "=words"
        }
      }
    },
    {
      "form": "warrant_request",
      "title": "Request to the tribunal's registrar for a warrant of possession",
      "does": "Asks the tribunal's registrar for a warrant on an order for possession whose day has passed with the tenant still there. The registrar issues it to whoever carries the tribunal's warrants out; the landlord puts nobody out. The fee, where there is one, is paid with it, by a payment. A warrant not carried out by its last day lapses, and another is asked for.",
      "fields": {
        "order": {
          "type": "record",
          "required": true,
          "description": "The tribunal's order for possession."
        }
      },
      "writes": {
        "sends": [
          {
            "to": [
              "@tribunal"
            ],
            "why": "The tribunal's registrar issues its warrants."
          }
        ],
        "kind": "warrant_request",
        "text": "Request for a warrant of possession under order {order}: the tenant has not left.",
        "basis": "=order",
        "to": [
          "@tribunal"
        ],
        "visible": [
          "=self",
          "@tribunal"
        ],
        "data": {
          "order": "=order"
        }
      }
    },
    {
