    {
      "does": "Declares the result of a ballot of members on industrial action, to the employer and the members: how many could vote, how many did, how many said yes, and whether it is approved. Action may be notified only on a ballot that meets what the law on industrial action asks.",
      "fields": {
        "ballot": {
          "description": "The ballot.",
          "type": "record"
        },
        "eligible": {
          "description": "How many could vote.",
          "required": true,
          "type": "count"
        },
        "employer": {
          "description": "The employer.",
          "required": true,
          "type": "entity"
        },
        "members": {
          "description": "The members balloted.",
          "required": true,
          "type": "list"
        },
        "passed": {
          "description": "Whether it is approved.",
          "options": [
            "yes",
            "no"
          ],
          "required": true,
          "type": "choice"
        },
        "voted": {
          "description": "How many voted.",
          "required": true,
          "type": "count"
        },
        "yes": {
          "description": "How many voted yes.",
          "required": true,
          "type": "count"
        }
      },
      "form": "ballot_result",
      "title": "Result of a ballot of members on industrial action",
      "writes": {
        "basis": "=ballot",
        "data": {
          "ballot": "=ballot",
          "eligible": "=eligible",
          "employer": "=employer",
          "passed": "?passed",
          "voted": "=voted",
          "yes": "=yes"
        },
        "kind": "ballot_result",
        "text": "Protected action ballot at {employer}: {voted} of {eligible} members voted, {yes} yes; approved {passed}.",
        "to": [
          "=employer",
          "=members"
        ],
        "visible": [
          "=self",
          "=employer",
          "=members"
        ]
      }
    }
