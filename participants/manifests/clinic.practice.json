{
  "name": "clinic.practice",
  "version": "0.2.1",
  "doc": "docs/behaviour/health.md",
  "params": {
    "account": {
      "schema": {
        "type": "string",
        "description": "what it pays its staff from (its funding comes in there)"
      },
      "default": "",
      "required": true,
      "source": "placeholder"
    },
    "building": {
      "schema": {
        "type": "string",
        "description": "the clinic, where its doctors work, and its waiting room (the world must say)"
      },
      "default": "",
      "required": true,
      "source": "the clinic, where its doctors work, and its waiting room (the world must say)"
    },
    "channel": {
      "schema": {
        "type": "string",
        "description": "its view of the building, who is where in it"
      },
      "default": "premises",
      "source": "placeholder"
    },
    "closes": {
      "schema": {
        "type": "integer"
      },
      "default": 64800,
      "source": "placeholder"
    },
    "consult_seconds": {
      "schema": {
        "type": "integer"
      },
      "unit": "seconds",
      "default": 1800,
      "source": "placeholder"
    },
    "consults": {
      "schema": {
        "type": "array"
      },
      "default": [],
      "source": "placeholder"
    },
    "doctors": {
      "schema": {
        "type": "integer",
        "description": "the establishment (its funder's)"
      },
      "default": 0,
      "source": "placeholder"
    },
    "give_up_days": {
      "schema": {
        "type": "integer",
        "description": "a patient who asked and isn't here after this long is dropped from the list"
      },
      "unit": "days",
      "default": 3,
      "source": "placeholder"
    },
    "industry": {
      "schema": {
        "type": "string"
      },
      "default": "health_care",
      "source": "placeholder"
    },
    "notice_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 14,
      "source": "placeholder"
    },
    "opens": {
      "schema": {
        "type": "integer",
        "description": "the hours it sees patients (placeholder)"
      },
      "default": 28800,
      "source": "the hours it sees patients (placeholder)"
    },
    "part": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "period": {
      "schema": {
        "type": "integer"
      },
      "default": 1209600,
      "source": "placeholder"
    },
    "role": {
      "schema": {
        "type": "string"
      },
      "default": "doctor",
      "source": "placeholder"
    },
    "treat_task": {
      "schema": {
        "type": "string"
      },
      "default": "treat",
      "source": "placeholder"
    },
    "wage": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "waiting": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "required": true,
      "source": "placeholder"
    },
    "work_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 5,
      "source": "placeholder"
    },
    "working_day": {
      "schema": {
        "type": "integer"
      },
      "default": 28800,
      "source": "placeholder"
    },
    "workplace": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "required": true,
      "source": "placeholder"
    }
  },
  "perceives": [],
  "state": "none",
  "issues": [
    {
      "form": "job_advertisement",
      "title": "Job advertisement",
      "fields": {
        "wage": {
          "type": "amount",
          "required": true,
          "description": "The wage for each pay period."
        },
        "period": {
          "type": "duration",
          "required": true,
          "description": "The pay period: how often the wage is paid."
        },
        "posts": {
          "type": "count",
          "required": true,
          "description": "How many posts this advertisement is for."
        },
        "account": {
          "type": "account",
          "description": "The account the wages are paid from, where the office itself pays them."
        }
      },
      "writes": {
        "kind": "job_posting",
        "text": "Hiring: {wage} every {period}.",
        "data": {
          "wage": "#wage",
          "period": "=period",
          "role": "@role",
          "industry": "@industry",
          "workplace": "@workplace_structure",
          "space": "@workplace"
        },
        "offer": {
          "by": "=self",
          "to": {
            "min_age_years": 18
          },
          "take_up": "apply",
          "available": "=posts",
          "terms": {
            "template": "employment",
            "commitments": [
              {
                "who": "=self",
                "does": {
                  "outcome": {
                    "money": {
                      "from": "=account",
                      "amount": "=wage",
                      "for": "wages"
                    }
                  }
                },
                "every": "=period"
              },
              "@occupancy"
            ],
            "termination": "@termination"
          }
        }
      }
    }
  ],
  "routines": [
    {
      "task": "treat",
      "at": "building",
      "what": "Each working day, in the hours the clinic is open, its doctors see those who have asked for care and are waiting, in the order they asked, as far as the doctors' hours go, and each patient is told they have been seen."
    }
  ]
}
