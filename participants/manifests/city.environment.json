{
  "name": "city.environment",
  "version": "0.4.0",
  "doc": "docs/behaviour/environment.md",
  "params": {
    "decline_flag_bps": {
      "schema": {
        "type": "integer",
        "description": "a fall this large since the last round is flagged in the report (placeholder)"
      },
      "unit": "bps",
      "default": 2000,
      "source": "a fall this large since the last round is flagged in the report (placeholder)"
    },
    "depot": {
      "schema": {
        "type": "string",
        "description": "where the office's staff work (the world must say)"
      },
      "default": "",
      "required": true,
      "source": "where the office's staff work (the world must say)"
    },
    "depot_channel": {
      "schema": {
        "type": "string"
      },
      "default": "depot",
      "source": "placeholder"
    },
    "directed_under": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "direction_compliance_bps": {
      "schema": {
        "type": "integer"
      },
      "unit": "bps",
      "default": 10000,
      "source": "placeholder"
    },
    "industry": {
      "schema": {
        "type": "string",
        "description": "what the work is (its postings say)"
      },
      "default": "",
      "source": "placeholder"
    },
    "look_at": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "look_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 5,
      "source": "placeholder"
    },
    "lots": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "source": "placeholder"
    },
    "notice_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 14,
      "source": "placeholder"
    },
    "period": {
      "schema": {
        "type": "integer"
      },
      "default": 1209600,
      "source": "placeholder"
    },
    "planning": {
      "schema": {
        "type": "string",
        "description": "whom the habitat register is for (the planning office's entity)"
      },
      "default": "",
      "required": true,
      "source": "placeholder"
    },
    "role": {
      "schema": {
        "type": "string"
      },
      "default": "environmental scientist",
      "source": "placeholder"
    },
    "sample_cells": {
      "schema": {
        "type": "integer",
        "description": "at most this many of a species' habitat cells a round (placeholder; hours permitting)"
      },
      "default": 60,
      "source": "at most this many of a species' habitat cells a round (placeholder; hours permitting)"
    },
    "species": {
      "schema": {
        "type": "array"
      },
      "default": [],
      "source": "placeholder"
    },
    "staff_line": {
      "schema": {
        "type": "string",
        "description": "the adopted budget's line that pays the staff"
      },
      "default": "environment",
      "source": "placeholder"
    },
    "survey_every_days": {
      "schema": {
        "type": "integer",
        "description": "a round of surveys: a quarter (placeholder)"
      },
      "unit": "days",
      "default": 91,
      "source": "a round of surveys: a quarter (placeholder)"
    },
    "survey_labour": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "survey_task": {
      "schema": {
        "type": "string",
        "description": "seconds of fieldwork a cell (the world's task)"
      },
      "default": "survey",
      "source": "placeholder"
    },
    "wage": {
      "schema": {
        "type": "integer"
      },
      "default": 0,
      "source": "placeholder"
    },
    "work_days": {
      "schema": {
        "type": "integer"
      },
      "unit": "days",
      "default": 5,
      "source": "placeholder"
    },
    "working_day": {
      "schema": {
        "type": "integer",
        "description": "when its staff are in (a time of day on working days: the world's; 0, whenever it wakes)"
      },
      "default": 28800,
      "source": "placeholder"
    },
    "workplace": {
      "schema": {
        "type": "string"
      },
      "default": "",
      "required": true,
      "source": "placeholder"
    }
  },
  "perceives": [],
  "state": "none",
  "takes": [
    {
      "form": "environment_staffing",
      "title": "Staffing direction to the environment office",
      "fields": {
        "recruit": {
          "type": "choice",
          "options": [
            "yes",
            "no"
          ],
          "required": true,
          "description": "Whether the environment office recruits: yes, it advertises and fills the posts it is short of; no, it advertises none and takes nobody on."
        },
        "posts": {
          "type": "count",
          "description": "The most environmental scientists it is to have, where that is fewer than its budget pays for. Left out: as many as the budget pays for."
        }
      },
      "follows": "While a direction with recruit no stands, the environment office advertises no post, takes down the advertisements it has out and offers nobody employment. With recruit yes it recruits up to what its budget pays for, or up to posts where that is fewer. Nobody is stood down by it and nobody's pay changes."
    }
  ],
  "issues": [
    {
      "form": "job_advertisement",
      "title": "Job advertisement",
      "does": "How the office takes on staff of its own: it puts the posts on the jobs board at the wage given, for people to apply, and the office then offers employment to those it takes on. It commits no money until someone is taken on.",
      "fields": {
        "wage": {
          "type": "amount",
          "required": true,
          "description": "The wage for each pay period."
        },
        "period": {
          "type": "duration",
          "required": true,
          "description": "The pay period: how often the wage is paid."
        },
        "posts": {
          "type": "count",
          "required": true,
          "description": "How many posts this advertisement is for."
        },
        "account": {
          "type": "account",
          "description": "The account the wages are paid from, where the office itself pays them."
        }
      },
      "writes": {
        "kind": "job_posting",
        "text": "Hiring: {wage} every {period}.",
        "data": {
          "wage": "#wage",
          "period": "=period",
          "role": "@role",
          "industry": "@industry",
          "workplace": "@workplace_structure",
          "space": "@workplace"
        },
        "offer": {
          "by": "=self",
          "to": {
            "min_age_years": 18
          },
          "take_up": "apply",
          "available": "=posts",
          "terms": {
            "template": "employment",
            "commitments": [
              {
                "who": "=self",
                "does": {
                  "outcome": {
                    "money": {
                      "from": "=account",
                      "amount": "=wage",
                      "for": "wages"
                    }
                  }
                },
                "every": "=period"
              },
              "@occupancy"
            ],
            "termination": "@termination"
          }
        }
      }
    },
    {
      "form": "habitat_register",
      "title": "Register of the lots where a listed species was found",
      "does": "Publishes the lots where a survey found a listed species: the planning office refuses permits on them.",
      "fields": {
        "round": {
          "type": "count",
          "required": true,
          "description": "The survey round it is from."
        },
        "lots": {
          "type": "list",
          "required": true,
          "description": "The lots."
        }
      },
      "writes": {
        "kind": "habitat_register",
        "text": "Habitat register, round {round}: {lots}.",
        "to": [
          "@planning"
        ],
        "visible": "public",
        "data": {
          "round": "=round",
          "lots": "=lots"
        }
      }
    }
  ]
}
