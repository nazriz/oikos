{
  "name": "world.tax_collector",
  "version": "0.1.0",
  "doc": "docs/behaviour/public-finance.md",
  "params": {},
  "perceives": [],
  "state": "none",
  "issues": [
    {
      "form": "tax_credit_decision",
      "title": "Decision on a claim for tax paid and not owed",
      "does": "Says what is decided on a taxpayer's claim, to the taxpayer: a refund granted (and how much), a credit that may be set against its next return, or a refusal and why. A refund granted on it is paid by a payment from the collector's account into the account the claim names; it moves no money by itself.",
      "fields": {
        "claim": {
          "type": "record",
          "required": true,
          "description": "The claim decided."
        },
        "taxpayer": {
          "type": "entity",
          "required": true,
          "description": "Who made the claim."
        },
        "use": {
          "type": "choice",
          "required": true,
          "options": [
            "refund",
            "set_off"
          ],
          "description": "What was asked for."
        },
        "granted": {
          "type": "choice",
          "required": true,
          "options": [
            "yes",
            "no"
          ],
          "description": "Whether it is granted."
        },
        "amount": {
          "type": "amount",
          "description": "Where granted: how much."
        },
        "reason": {
          "type": "text",
          "description": "Why not, or why less than was asked."
        }
      },
      "writes": {
        "kind": "tax_credit_decision",
        "text": "Claim {claim}: granted {granted}.",
        "basis": "=claim",
        "to": [
          "=taxpayer"
        ],
        "visible": [
          "=taxpayer",
          "=self"
        ],
        "data": {
          "claim": "=claim",
          "taxpayer": "=taxpayer",
          "use": "=use",
          "granted": "?granted",
          "amount": "#amount",
          "reason": "=reason"
        }
      }
    },
    {
      "form": "tax_statement",
      "title": "Statement of a taxpayer's account",
      "does": "Tells a taxpayer how its own account stands: what its returns say was owed, what was received from it, what was repaid, and what is owing or in credit. It changes nothing on the account.",
      "fields": {
        "taxpayer": {
          "type": "entity",
          "required": true,
          "description": "Whose account."
        },
        "owed": {
          "type": "amount",
          "required": true,
          "description": "Owed on its returns, in all."
        },
        "paid": {
          "type": "amount",
          "required": true,
          "description": "Received from it, in all."
        },
        "refunded": {
          "type": "amount",
          "description": "Repaid to it, in all."
        },
        "credit": {
          "type": "amount",
          "description": "In credit by (nothing: 0)."
        },
        "outstanding": {
          "type": "amount",
          "description": "Owing (nothing: 0)."
        }
      },
      "writes": {
        "kind": "tax_statement",
        "text": "Statement of account: owed {owed}, paid {paid}; in credit {credit}.",
        "to": [
          "=taxpayer"
        ],
        "visible": [
          "=taxpayer",
          "=self"
        ],
        "data": {
          "taxpayer": "=taxpayer",
          "owed": "#owed",
          "paid": "#paid",
          "refunded": "#refunded",
          "credit": "#credit",
          "outstanding": "#outstanding"
        }
      }
    }
  ]
}
