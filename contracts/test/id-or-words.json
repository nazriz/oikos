    { "name": "a post's id with a capital is its name", "seat": "forms", "as": "mayor", "program": "message(to={}, text=\"Please report.\")", "fn": "message", "arg": "to", "a": ["id", "registry"], "b": ["id", "Registry"], "same": true },
    { "name": "a letter's words", "seat": "forms", "as": "mayor", "program": "message(to=registry, text={})", "fn": "message", "arg": "text", "a": ["id", "thanks"], "b": ["text", "thanks"], "same": true },
    { "name": "an amount", "seat": "holds", "program": "money(to=acc-greenco, amount={}, from=acc-city)", "fn": "money", "arg": "amount", "a": ["id", "5"], "b": ["text", "5"], "same": true },
    { "name": "a letter to an organisation the seat knows", "seat": "holds", "program": "message(to={}, text=\"Please report.\")", "fn": "message", "arg": "to", "a": ["id", "greenco"], "b": ["text", "greenco"], "same": true },
    { "name": "an account is never a name", "seat": "holds", "program": "money(to=acc-greenco, amount=\"5\", from={})", "fn": "money", "arg": "from", "a": ["id", "acc-city"], "b": ["text", "acc-city"], "same": false },
    { "name": "a record cited is never a name", "seat": "holds", "program": "money(to=acc-greenco, amount=\"5\", from=acc-city, basis={})", "fn": "money", "arg": "basis", "a": ["id", "rec.44"], "b": ["text", "rec.44"], "same": false }
