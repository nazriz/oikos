{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oikos:contracts:0.8:dataset",
  "title": "Run dataset (0.2.0)",
  "description": "A run's data, derived deterministically from its log, joined and flattened into examples a training run can use (docs/design/run-datasets.md). A folder per run: manifest.json (Manifest), systems.jsonl (SystemPrompt), translations.jsonl (Translation), decisions.jsonl (Decision), and optionally actions.jsonl (Action), observations.jsonl (ObservationRow) and citizen_decisions.jsonl (CitizenDecision). The log stays the record; a dataset can always be made again from it.",
  "$defs": {
    "Version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "Row": {
      "description": "Fields every row carries.",
      "type": "object",
      "required": [
        "run"
      ],
      "properties": {
        "run": {
          "description": "The run's id.",
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "Manifest": {
      "type": "object",
      "required": [
        "dataset",
        "version",
        "run",
        "world",
        "config_hash",
        "initial_state_hash",
        "log",
        "versions",
        "seats",
        "end",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "const": "oikos-run-dataset"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "run": {
          "type": "string",
          "maxLength": 200
        },
        "world": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "seed": {
              "type": "integer"
            }
          }
        },
        "config_hash": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Hash"
        },
        "initial_state_hash": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Hash"
        },
        "log": {
          "description": "The log it was made from: its file name, entries, and the last entry's hash (which pins the whole chain).",
          "type": "object",
          "required": [
            "file",
            "entries",
            "last_hash"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "entries": {
              "$ref": "urn:oikos:contracts:0.8:common#/$defs/Count"
            },
            "last_hash": {
              "$ref": "urn:oikos:contracts:0.8:common#/$defs/Hash"
            }
          }
        },
        "versions": {
          "description": "What made the run: contracts, kernel, orchestrator, behaviour modules (name -> {version, sha256}), translator.",
          "type": "object",
          "required": [
            "contracts",
            "kernel",
            "orchestrator"
          ],
          "additionalProperties": false,
          "properties": {
            "contracts": {
              "type": "string"
            },
            "kernel": {
              "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
            },
            "orchestrator": {
              "type": "string"
            },
            "modules": {
              "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
            },
            "translator": {
              "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
            }
          }
        },
        "seats": {
          "description": "The language-model seats: participant -> the model configured and the one used; and the price table.",
          "type": "object",
          "required": [
            "models"
          ],
          "additionalProperties": false,
          "properties": {
            "models": {
              "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
            },
            "prices": {
              "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
            }
          }
        },
        "end": {
          "type": "object",
          "required": [
            "t"
          ],
          "additionalProperties": false,
          "properties": {
            "t": {
              "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "files": {
          "description": "Each file written: its rows, and how many are synthetic (from the mock).",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "rows"
            ],
            "additionalProperties": false,
            "properties": {
              "rows": {
                "$ref": "urn:oikos:contracts:0.8:common#/$defs/Count"
              },
              "synthetic": {
                "$ref": "urn:oikos:contracts:0.8:common#/$defs/Count"
              }
            }
          }
        }
      }
    },
    "SystemPrompt": {
      "type": "object",
      "required": [
        "run",
        "sha256",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "string"
        },
        "sha256": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Hash"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "Turn": {
      "description": "One model call in an exchange: what it was shown (the last message) and what it answered, in full.",
      "type": "object",
      "required": [
        "turn",
        "input",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "input": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        },
        "output": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        }
      }
    },
    "Executed": {
      "description": "A command carried out: its place in the log, and whether the kernel applied it (and if not, why).",
      "type": "object",
      "required": [
        "seq",
        "applied"
      ],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Count"
        },
        "applied": {
          "type": "boolean"
        },
        "refusal": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        }
      }
    },
    "Translation": {
      "type": "object",
      "required": [
        "run",
        "draft",
        "t",
        "participant",
        "synthetic",
        "exchange",
        "retries",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "string"
        },
        "draft": {
          "type": "string"
        },
        "t": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
        },
        "participant": {
          "type": "string"
        },
        "as": {
          "type": "string"
        },
        "proposal": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        },
        "system_sha256": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Hash"
        },
        "exchange": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Turn"
          }
        },
        "retries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "attempt",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "attempt": {
                "type": "integer"
              },
              "reason": {
                "type": "string"
              },
              "call": {
                "type": "string"
              }
            }
          }
        },
        "result": {
          "enum": [
            "drafted",
            "failed",
            "unknown"
          ]
        },
        "translator": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        },
        "call": {
          "type": "string"
        },
        "blocks": {
          "type": "array"
        },
        "summary": {
          "type": "string"
        },
        "check": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        },
        "caveats": {
          "type": "string"
        },
        "failure": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        },
        "signoff": {
          "type": "object",
          "required": [
            "decision"
          ],
          "additionalProperties": false,
          "properties": {
            "decision": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "executed": {
          "$ref": "#/$defs/Executed"
        }
      }
    },
    "Command": {
      "description": "A command a participant gave, as logged, and what came of it.",
      "type": "object",
      "required": [
        "seq",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Count"
        },
        "command": {
          "type": "string"
        },
        "as": {
          "type": "string"
        },
        "blocks": {
          "type": "array"
        },
        "looks": {
          "type": "array"
        },
        "provenance": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        },
        "reasoning": {
          "type": "string"
        },
        "applied": {
          "description": "For an act: whether it was applied, or refused (`refusal`: why), joined by the act's action (an act takes time, and how it ended is logged when it ends). Absent: not an act, or still under way when the log ended.",
          "type": "boolean"
        },
        "refusal": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        },
        "created": {
          "description": "The ids of what the act made, as the log's events for it say: records (a notice, a decision, an order, an agreement) and letters. What is later written in answer names one of them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Decision": {
      "description": "A language-model participant's model call: what it was shown, what it answered, what followed in the world, and what had come back of its earlier acts.",
      "type": "object",
      "required": [
        "run",
        "t",
        "participant",
        "model",
        "synthetic",
        "system_sha256",
        "turn",
        "input",
        "output",
        "commands",
        "drafts"
      ],
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "string"
        },
        "t": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
        },
        "participant": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        },
        "system_sha256": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Hash"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "input": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        },
        "output": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "integer"
            },
            "output": {
              "type": "integer"
            },
            "cost_microusd": {
              "type": "integer"
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Command"
          }
        },
        "drafts": {
          "description": "Drafts it proposed or signed (translations.jsonl).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "came_back": {
          "description": "What the seat had been shown, since its last model call, that names something an earlier act of its own made: a reply to its letter, a decision on its form, a paper made on its direction, a vote on its proposal. `of`: the id of what the seat made; `seq`: the command that made it (a row of some earlier call's `commands`); `in`: the id of the record or letter that names it (in observations.jsonl); `from`: who wrote it, for a letter. A join by reference and nothing more: it does not say whether what came back was what the seat wanted.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "of",
              "seq",
              "in"
            ],
            "additionalProperties": false,
            "properties": {
              "of": {
                "type": "string"
              },
              "seq": {
                "$ref": "urn:oikos:contracts:0.8:common#/$defs/Count"
              },
              "in": {
                "type": "string"
              },
              "from": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "Action": {
      "description": "An act by a code participant: the rule it followed (in words), the call, the blocks, and whether it was applied.",
      "type": "object",
      "required": [
        "run",
        "t",
        "seq",
        "participant"
      ],
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "string"
        },
        "t": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
        },
        "seq": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Count"
        },
        "participant": {
          "type": "string"
        },
        "as": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "call": {
          "type": "string"
        },
        "blocks": {
          "type": "array"
        },
        "applied": {
          "description": "Whether the act was applied, or refused (`refusal`: why). Joined by the act's action: an act takes time, and how it ended is logged when it ends. Absent: still under way when the log ended.",
          "type": "boolean"
        },
        "refusal": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        },
        "created": {
          "description": "The ids of what the act made, as the log's events for it say: records (a notice, a decision, an order, an agreement) and letters. What is later written in answer names one of them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ObservationRow": {
      "description": "An observation a participant received (recorded only when the run was asked to): what's new since its last.",
      "type": "object",
      "required": [
        "run",
        "t",
        "participant",
        "observation"
      ],
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "string"
        },
        "t": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
        },
        "participant": {
          "type": "string"
        },
        "as": {
          "type": "string"
        },
        "observation": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/Opaque"
        }
      }
    },
    "CitizenDecision": {
      "description": "A code citizen's decision, as its mind made it (docs/design/ai-citizens.md 7): what it had before it (each option's facts, how many it knows took it, what it means to them, what they have learned of it; their routine; their circumstances), how it decided (repeat, imitate, compare, deliberate), each option's score (basis points), and what it chose. Facts as the citizen had them, and the mind's own figures: nothing here says whether a choice was good. Training data for citizen models, and the baseline they're compared with. What followed is in the log after `seq`, by the same participant (actions.jsonl rows carry `seq`).",
      "type": "object",
      "required": [
        "run",
        "t",
        "participant",
        "domain",
        "strategy",
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "string"
        },
        "t": {
          "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
        },
        "seq": {
          "description": "Where the decision stands in the run's log (the annotation's sequence number): the citizen's acts that carried it out, and what came of them, are that participant's entries after it.",
          "type": "integer",
          "minimum": 0
        },
        "participant": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "strategy": {
          "enum": [
            "repeat",
            "imitate",
            "compare",
            "deliberate",
            "model"
          ]
        },
        "choice": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "score"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "score": {
                "type": "integer"
              },
              "facts": {
                "description": "What taking it up would change in a month, as the citizen appraised it (from an offer's typed terms): money in (+) or out (-), in minor units; a home, and its bedrooms where known; hours of work; goods (units); company (people); hours of one's own time.",
                "type": "object",
                "required": [
                  "money_per_month"
                ],
                "additionalProperties": false,
                "properties": {
                  "money_per_month": {
                    "type": "integer"
                  },
                  "home": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "bedrooms": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "work_hours_per_month": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "goods_per_month": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "company": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "time_hours_per_month": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "others": {
                "description": "How many people the citizen knows took it (told so, or led there).",
                "type": "integer",
                "minimum": 1
              },
              "meaning": {
                "description": "What it means to them beyond its facts, from what they believe or were told (basis points; may be negative).",
                "type": "integer"
              },
              "learned": {
                "description": "What the citizen has learned of it from their own experience and what others told them (its attraction, on the payoff scale: basis points), when it decided. Absent: never tried nor heard of.",
                "type": "integer"
              }
            }
          },
          "description": "Every option the citizen had before it, by key. `score` is 0 where the way of deciding gave it none: all of them under repeat; under imitate, those nobody known to the citizen took."
        },
        "current": {
          "description": "The option that is the citizen's routine, if they have one.",
          "type": "string"
        },
        "circumstances": {
          "description": "Where the citizen stood: the household's income a month and their savings (minor units), whether without a home, the bedrooms the household needs (home decisions), and what a month's essentials cost in their world.",
          "type": "object",
          "required": [
            "monthly_income",
            "savings",
            "homeless"
          ],
          "additionalProperties": false,
          "properties": {
            "monthly_income": {
              "type": "integer"
            },
            "savings": {
              "type": "integer"
            },
            "homeless": {
              "type": "boolean"
            },
            "bedrooms_needed": {
              "type": "integer",
              "minimum": 0
            },
            "essentials": {
              "type": "integer"
            }
          }
        },
        "satisfied_here": {
          "description": "How this area of life has gone for them, where the decision was given it (basis points).",
          "type": "integer"
        },
        "doubt": {
          "description": "What a feeling (fear) took from how sure they were of their options (basis points), when above 0.",
          "type": "integer",
          "minimum": 0
        },
        "person": {
          "description": "Who the citizen is: values, temperament and how much each need weighs (basis points; weights 10000 to 20000). It does not change, and comes with a citizen's first recorded decision only (again after a restart of its controller).",
          "type": "object",
          "required": [
            "values",
            "temperament",
            "weights"
          ],
          "additionalProperties": false,
          "properties": {
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "temperament": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "weights": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20000
              }
            }
          }
        },
        "state": {
          "description": "The citizen's state behind the decision (docs/design/contracts-0.7.md A2): the core (needs, satisfaction, certainty) always; emotion, beliefs and goal when there are any. Versioned by the mind that produced it.",
          "type": "object",
          "required": [
            "mind",
            "needs",
            "satisfaction",
            "certainty"
          ],
          "additionalProperties": false,
          "properties": {
            "mind": {
              "type": "string",
              "maxLength": 32
            },
            "needs": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "satisfaction": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "certainty": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "emotion": {
              "type": "object",
              "required": [
                "kind",
                "about",
                "bps"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "maxLength": 32
                },
                "about": {
                  "type": "string",
                  "maxLength": 128
                },
                "bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            },
            "beliefs": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "goal": {
              "type": "object",
              "required": [
                "goal",
                "method"
              ],
              "additionalProperties": false,
              "properties": {
                "goal": {
                  "type": "string",
                  "maxLength": 64
                },
                "method": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            }
          }
        }
      }
    }
  }
}
