{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oikos:contracts:0.8:entity-record",
  "title": "Oikos entity record: a person's sections",
  "description": "An entity's own record (docs/design/ai-citizens.md 10d): who they are and how things stand with them, as their mind keeps it. The kernel holds one per entity, is its only writer (the log's entity_record command), reads none of it, and refuses a change that would take it past the world's caps.entity_record_bytes: it never grows. This schema is the shape a person's record has as the code citizen writes it: every list is bounded here, so the most a record can hold can be read from this file. Whole numbers only; levels are basis points (0 to 10000), views and affinities -10000 to 10000. Nothing in it says whether anything is good or bad. Only the entity is ever shown its record (world-config Channel kind own_record).",
  "$defs": {
    "PersonRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": {
          "description": "Schwartz's ten basic values: what the person believes in. They drift slowly and are shocked by what happens (a death, a child, ruin, losing a home).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "self_direction",
            "stimulation",
            "hedonism",
            "achievement",
            "power",
            "security",
            "conformity",
            "tradition",
            "benevolence",
            "universalism"
          ],
          "properties": {
            "self_direction": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "stimulation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "hedonism": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "achievement": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "power": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "security": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "conformity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "tradition": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "benevolence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "universalism": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "temperament": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "openness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "conformity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "prestige": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "openness",
            "conformity",
            "prestige"
          ],
          "description": "How the person acts, apart from what they believe. Hardly ever moves."
        },
        "needs": {
          "description": "How well each need is met now, as the person judges their own life. Absent for a child.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subsistence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "shelter": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "security": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "social": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "status": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "belonging": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "meaning": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "agency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "now": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "own": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "now",
            "own"
          ],
          "description": "Sense of agency: how far the person believes that what they do makes a difference, now; and their own level, which it returns to."
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "people": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "in": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "in": {
                    "$ref": "urn:oikos:contracts:0.8:common#/$defs/Id"
                  },
                  "kind": {
                    "$ref": "urn:oikos:contracts:0.8:common#/$defs/Label"
                  },
                  "bps": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  }
                },
                "required": [
                  "in",
                  "kind",
                  "bps"
                ]
              }
            }
          },
          "required": [
            "in"
          ],
          "description": "Trust in particular institutions and bodies (this bank, this council, this landlord), each with the kind of institution it is to the person; and in people in general."
        },
        "attached": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "place": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {
                  "type": "string",
                  "maxLength": 128
                },
                "bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "since": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "to",
                "bps",
                "since"
              ]
            },
            "trade": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {
                  "type": "string",
                  "maxLength": 128
                },
                "bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "since": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "to",
                "bps",
                "since"
              ]
            },
            "group": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {
                  "type": "string",
                  "maxLength": 128
                },
                "bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "since": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "to",
                "bps",
                "since"
              ]
            }
          },
          "description": "Attachments: to a place, a trade, a group; how strongly, and since when."
        },
        "views": {
          "description": "Of each who holds power over the person (who governs, houses or employs them): what they think (`private`) and what they say (`expressed`). The gap depends on trust and fear.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "of": {
                "$ref": "urn:oikos:contracts:0.8:common#/$defs/Id"
              },
              "private": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              },
              "expressed": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              }
            },
            "required": [
              "of",
              "private",
              "expressed"
            ]
          }
        },
        "ties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "close": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "who": {
                    "$ref": "urn:oikos:contracts:0.8:common#/$defs/Id"
                  },
                  "affinity": {
                    "type": "integer",
                    "minimum": -10000,
                    "maximum": 10000
                  },
                  "trust": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "last": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "what": {
                        "$ref": "urn:oikos:contracts:0.8:common#/$defs/Label"
                      },
                      "t": {
                        "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
                      }
                    },
                    "required": [
                      "what",
                      "t"
                    ],
                    "description": "What last passed between them, and when."
                  }
                },
                "required": [
                  "who",
                  "affinity",
                  "trust"
                ]
              }
            },
            "resented": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "who": {
                    "$ref": "urn:oikos:contracts:0.8:common#/$defs/Id"
                  },
                  "affinity": {
                    "type": "integer",
                    "minimum": -10000,
                    "maximum": 10000
                  },
                  "trust": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "last": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "what": {
                        "$ref": "urn:oikos:contracts:0.8:common#/$defs/Label"
                      },
                      "t": {
                        "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
                      }
                    },
                    "required": [
                      "what",
                      "t"
                    ],
                    "description": "What last passed between them, and when."
                  }
                },
                "required": [
                  "who",
                  "affinity",
                  "trust"
                ]
              }
            }
          },
          "required": [
            "close",
            "resented"
          ],
          "description": "The closest few ties and the few most resented: affinity, trust, and what last passed between them."
        },
        "beliefs": {
          "description": "Teachings held: how strongly, and whose they are.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "teaching": {
                "$ref": "urn:oikos:contracts:0.8:common#/$defs/Id"
              },
              "bps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "from": {
                "$ref": "urn:oikos:contracts:0.8:common#/$defs/Id"
              }
            },
            "required": [
              "teaching",
              "bps"
            ]
          }
        },
        "norms": {
          "description": "What the person takes those around them to do and approve of, for each conduct the world holds (docs/design/ai-citizens.md section 14; docs/behaviour/culture.md). POSITIONAL: the place in the closed list of conducts is the conduct (answer_tribunal, stay_past_notice, take_to_tribunal, complain, take_in, join_union, strike, take_from_employer, apply_possession, heads_before_hours, order_possession, then room for one more), null where the person holds none, trailing nulls left off. A conduct's five numbers are `does`, of those they know of who met the occasion, the share they take to have done it; `approves`, how far they take those around them to approve; `own`, what they think themselves, from their values; `says`, what they say when asked (each a whole percent); and `n`, how much they have seen, as a weight held to a window. One person's belief, never the town's. Written again when a figure has moved by 2 in 100. Absent where the culture dial is off. (Positional because a record is canonicalised and hashed whole at every change: named rows were a quarter of a record.)",
          "type": "array",
          "maxItems": 12,
          "items": {
            "oneOf": [
              { "type": "null" },
              { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "integer", "minimum": 0, "maximum": 1000 } }
            ]
          }
        },
        "wants": {
          "description": "What the entity is trying to bring about (docs/design/ai-citizens.md 10a): what it is about and whom it concerns, what would satisfy it in the world's typed outcomes, the paper in its way, how much it matters, since when, where it came from, and what has been tried. Heaviest first. Empty for an entity that takes no initiative.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "about",
              "seeks",
              "weight",
              "since",
              "from",
              "tried"
            ],
            "properties": {
              "about": {
                "type": "string",
                "maxLength": 128,
                "description": "What it is about, in a word of the mind's own: a need (security, shelter, belonging ...) or what happened (rent_increase, notice, let_go, unpaid, loss, slight, service ...)."
              },
              "whom": {
                "type": "string",
                "maxLength": 128,
                "description": "Whom it concerns, where it is about someone: a person, an organisation or a post (a grievance against this landlord, this employer, this council; someone lost). A want may seek nothing typed and be about someone only."
              },
              "seeks": {
                "type": "array",
                "maxItems": 6,
                "description": "What would satisfy it, as typed outcomes of the blocks' vocabulary (money, occupancy, work, attend, goods), with \"me\" where the entity itself stands: any one of them would. Empty: nothing typed (a grievance).",
                "items": {
                  "$ref": "urn:oikos:contracts:0.8:common#/$defs/OpaqueObject"
                }
              },
              "against": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record",
                  "kind",
                  "by"
                ],
                "description": "The paper that stands in its way (a notice, a rise, a debt): which, of what kind, and who made it.",
                "properties": {
                  "record": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "kind": {
                    "$ref": "urn:oikos:contracts:0.8:common#/$defs/Label"
                  },
                  "by": {
                    "type": "string",
                    "maxLength": 128
                  }
                }
              },
              "weight": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "since": {
                "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
              },
              "from": {
                "enum": [
                  "need",
                  "event",
                  "other"
                ],
                "description": "Born of a need as values weigh it, of something that happened, or of what someone the entity copies is after."
              },
              "with": {
                "type": "string",
                "maxLength": 128,
                "description": "The household it is held with, where it is a household's: each member holds it in their own record, with their own weight."
              },
              "tried": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000,
                "description": "How often something was tried for it (waiting counts)."
              },
              "way": {
                "type": "string",
                "maxLength": 160,
                "description": "The way last taken: an opening by how it is taken up and of what or whom (offer:employment, offer:lease, practice:<host>, join:<host>, ask:<party>, desk:<office>, petition:<id>, stand:<notice>, self, ties), or wait."
              }
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recent": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "what": {
                    "$ref": "urn:oikos:contracts:0.8:common#/$defs/Label"
                  },
                  "about": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  }
                },
                "required": [
                  "t",
                  "what",
                  "size"
                ],
                "description": "Something that happened: when, what (a word of the mind's own: hired, bereaved, evicted, job_lost, ruined, child, ...), about whom, and how large it was to them."
              }
            },
            "defining": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "what": {
                    "$ref": "urn:oikos:contracts:0.8:common#/$defs/Label"
                  },
                  "about": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  }
                },
                "required": [
                  "t",
                  "what",
                  "size"
                ],
                "description": "Something that happened: when, what (a word of the mind's own: hired, bereaved, evicted, job_lost, ruined, child, ...), about whom, and how large it was to them."
              }
            }
          },
          "required": [
            "recent",
            "defining"
          ],
          "description": "Bounded memory: the last few things that happened, and the few that defined the person, kept for good."
        },
        "hours": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
            },
            "to": {
              "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
            },
            "seconds": {
              "type": "object",
              "maxProperties": 10,
              "propertyNames": {
                "$ref": "urn:oikos:contracts:0.8:common#/$defs/Label"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31536000
              }
            }
          },
          "required": [
            "from",
            "to",
            "seconds"
          ],
          "description": "Where the hours of the last period went: seconds by what the person was at (work, learning, gathering, care, home, away)."
        },
        "circumstances": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "household": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "housed": {
              "enum": [
                0,
                1
              ]
            },
            "working": {
              "enum": [
                0,
                1
              ]
            },
            "retired": {
              "enum": [
                0,
                1
              ]
            },
            "income": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "savings": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "household",
            "housed",
            "working",
            "retired"
          ],
          "description": "How things stand: the household's size, whether housed, in work, stopped work; a month's income and the money in hand, in the world's smallest unit of money (written again when they move by a twentieth)."
        }
      },
      "description": "A person's record: every section optional (a record is set section by section), every list bounded."
    },
    "OrganisationRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "An organisation's own record (a firm, a landlord, a group founded in a run): its character, drawn from the values of whoever owns most of it; its wants; and the last things that happened to it. Written by the bookkeeping of the one post of the organisation that keeps it (world config: the position's keeps_record).",
      "properties": {
        "character": {
          "type": "object",
          "additionalProperties": false,
          "description": "How much each of an organisation's standing wants weighs with it (basis points; 5000: as the town's mean owner would have it): to keep trading, to grow, to keep a customer, tenant or worker, to be rid of one, to pay less, to be thought well of.",
          "required": [
            "keep_trading",
            "grow",
            "keep",
            "be_rid",
            "pay_less",
            "standing"
          ],
          "properties": {
            "keep_trading": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "grow": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "keep": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "be_rid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "pay_less": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "standing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "wants": {
          "description": "What the entity is trying to bring about (docs/design/ai-citizens.md 10a): what it is about and whom it concerns, what would satisfy it in the world's typed outcomes, the paper in its way, how much it matters, since when, where it came from, and what has been tried. Heaviest first. Empty for an entity that takes no initiative.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "about",
              "seeks",
              "weight",
              "since",
              "from",
              "tried"
            ],
            "properties": {
              "about": {
                "type": "string",
                "maxLength": 128,
                "description": "What it is about, in a word of the mind's own: a need (security, shelter, belonging ...) or what happened (rent_increase, notice, let_go, unpaid, loss, slight, service ...)."
              },
              "whom": {
                "type": "string",
                "maxLength": 128,
                "description": "Whom it concerns, where it is about someone: a person, an organisation or a post (a grievance against this landlord, this employer, this council; someone lost). A want may seek nothing typed and be about someone only."
              },
              "seeks": {
                "type": "array",
                "maxItems": 6,
                "description": "What would satisfy it, as typed outcomes of the blocks' vocabulary (money, occupancy, work, attend, goods), with \"me\" where the entity itself stands: any one of them would. Empty: nothing typed (a grievance).",
                "items": {
                  "$ref": "urn:oikos:contracts:0.8:common#/$defs/OpaqueObject"
                }
              },
              "against": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record",
                  "kind",
                  "by"
                ],
                "description": "The paper that stands in its way (a notice, a rise, a debt): which, of what kind, and who made it.",
                "properties": {
                  "record": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "kind": {
                    "$ref": "urn:oikos:contracts:0.8:common#/$defs/Label"
                  },
                  "by": {
                    "type": "string",
                    "maxLength": 128
                  }
                }
              },
              "weight": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "since": {
                "$ref": "urn:oikos:contracts:0.8:common#/$defs/SimTime"
              },
              "from": {
                "enum": [
                  "need",
                  "event",
                  "other"
                ],
                "description": "Born of a need as values weigh it, of something that happened, or of what someone the entity copies is after."
              },
              "with": {
                "type": "string",
                "maxLength": 128,
                "description": "The household it is held with, where it is a household's: each member holds it in their own record, with their own weight."
              },
              "tried": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000,
                "description": "How often something was tried for it (waiting counts)."
              },
              "way": {
                "type": "string",
                "maxLength": 160,
                "description": "The way last taken: an opening by how it is taken up and of what or whom (offer:employment, offer:lease, practice:<host>, join:<host>, ask:<party>, desk:<office>, petition:<id>, stand:<notice>, self, ties), or wait."
