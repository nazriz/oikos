{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terrarium:contracts:0.3:seat-api",
  "title": "Terrarium seat API",
  "description": "The only window a controller has onto the world. Identical for code, LLM, human and RL controllers (VISION principle 4). Shaped like PettingZoo's AEC API: the environment selects the next seat to act (the one whose wake time or triggering event comes first on the world clock), the seat reads last() and calls step(action). There are no turns. A seat perceives only through its channels; there is no mandate and no approval queue in v0.2, because authority is a matter of records and people (D20).",
  "$defs": {
    "StepResult": {
      "description": "What last() returns for the selected seat. 'reward' is always 0: the platform does not judge. Researchers who want RL rewards compute them outside the world from logs or observations and wrap the environment.",
      "type": "object",
      "required": [
        "observation",
        "reward",
        "termination",
        "truncation",
        "info"
      ],
      "additionalProperties": false,
      "properties": {
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "reward": {
          "const": 0
        },
        "termination": {
          "description": "The seat has opted out of the study (VISION §15; D38) and no stand-in continues it.",
          "type": "boolean"
        },
        "truncation": {
          "description": "The run reached clock.run_seconds or was stopped.",
          "type": "boolean"
        },
        "info": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actions_left_this_wake": {
              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Count"
            }
          }
        }
      }
    },
    "Observation": {
      "description": "What a seat perceives. Built by the kernel (deterministic, logged by hash) plus 'drafts' and 'notices', added by the orchestrator. 'outcomes', 'inbox' and 'notices' hold only what is new since the seat's previous observation.",
      "type": "object",
      "required": [
        "seat",
        "t",
        "status",
        "entity",
        "outcomes",
        "inbox",
        "drafts",
        "channels"
      ],
      "additionalProperties": false,
      "properties": {
        "seat": {
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/ConfigId"
        },
        "t": {
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/SimTime"
        },
        "status": {
          "enum": [
            "active",
            "opted_out"
          ]
        },
        "entity": {
          "description": "The entity this seat acts as.",
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Outcome"
          }
        },
        "inbox": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        },
        "drafts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Draft"
          }
        },
        "notices": {
          "description": "Added by the orchestrator: what the seat needs to know about its own requests that isn't world state, e.g. that a proposal couldn't be drafted, or that a draft it tried to sign doesn't exist. Logged as annotations (translation_failure, note). Absent when there are none.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "text"],
            "additionalProperties": false,
            "properties": {
              "t": { "$ref": "urn:terrarium:contracts:0.3:common#/$defs/SimTime" },
              "text": { "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text" },
              "re": { "description": "The draft or proposal it's about.", "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
            }
          }
        },
        "channels": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:terrarium:contracts:0.3:common#/$defs/ConfigId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ChannelData"
          }
        }
      }
    },
    "Outcome": {
      "description": "What happened to one of this seat's actions. There are only two outcomes: applied, or refused because it was physically impossible.",
      "type": "object",
      "required": [
        "action",
        "t",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/KernelId"
        },
        "t": {
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/SimTime"
        },
        "status": {
          "enum": [
            "applied",
            "refused"
          ]
        },
        "created": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:terrarium:contracts:0.3:common#/$defs/RefName"
          },
          "additionalProperties": {
            "$ref": "urn:terrarium:contracts:0.3:common#/$defs/KernelId"
          }
        },
        "refusal": {
          "type": "object",
          "required": [
            "code"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "urn:terrarium:contracts:0.3:log#/$defs/RefusalCode"
            },
            "block": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            "detail": {
              "type": "string",
              "maxLength": 2000
            }
          }
        }
      }
    },
    "Message": {
      "type": "object",
      "required": [
        "id",
        "t",
        "from",
        "to",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/KernelId"
        },
        "t": {
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/SimTime"
        },
        "from": {
          "description": "Sending seat.",
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/ConfigId"
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
          }
        },
        "text": {
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text"
        },
        "re": {
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
        }
      }
    },
    "ResolverId": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "TranslatorId": {
      "type": "object",
      "required": [
        "id",
        "version",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "version": {
          "description": "Translator release; prompt changes bump it so experiments can hold it fixed.",
          "type": "string",
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "prompt_hash": {
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Hash"
        }
      }
    },
    "Draft": {
      "description": "A plain-language proposal as the seat will see it before anything takes effect: the translator's call, the resolver's acts, and a mechanical preview of exactly what will happen, in world terms. draft_hash = SHA-256 of 'terrarium.draft.v1\\n' + canonical JSON of this object. The confirmed hash is carried into the act command, so the seat confirmed exactly this.",
      "type": "object",
      "required": [
        "id",
        "seat",
        "proposal",
        "blocks",
        "summary",
        "check",
        "translator",
        "call",
        "resolver"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "seat": {
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/ConfigId"
        },
        "proposal": {
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text"
        },
        "blocks": {
          "$ref": "urn:terrarium:contracts:0.3:blocks#/$defs/Action/properties/blocks"
        },
        "call": {
          "description": "The translator's reading of the proposal, in the call language (canonical form).",
          "type": "string",
          "maxLength": 4000
        },
        "resolver": {
          "$ref": "#/$defs/ResolverId"
        },
        "summary": {
          "description": "The preview: exactly what the blocks will do, generated mechanically from them in world terms (never written by the translator).",
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text"
        },
        "check": {
          "description": "Kernel dry run of the blocks at drafting time: would physics allow them? Plus the translator's warnings about records (e.g. laws the plan appears to break). The world may change before sign-off; the kernel re-checks on submission.",
          "type": "object",
          "required": [
            "ok"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "refusal": {
              "$ref": "#/$defs/Outcome/properties/refusal"
            },
            "warnings": {
              "description": "Things the translator noticed but the kernel doesn't judge, e.g. 'this appears to break law rec.4 (river zone)'. Informational; the seat decides.",
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2000
              },
              "maxItems": 32
            }
          }
        },
        "caveats": {
          "description": "Parts of the proposal the translator could not express in blocks.",
          "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text"
        },
        "translator": {
          "$ref": "#/$defs/TranslatorId"
        }
      }
    },
    "SeatAction": {
      "description": "What a seat passes to step(). Carries no seat id: the orchestrator binds identity from the connection. act and message go straight to the kernel; call (a structured intent in the call language) goes to the resolver, which turns it into the seat's own acts; propose (plain language) goes to the translator and resolver and comes back as a draft to confirm; sign confirms (accept) or declines (reject) a draft; wait yields until 'until' or the next item addressed to this seat, whichever is first; opt_out leaves the study (VISION \u00a715; D38): always available and final. It is not resigning an office, which is an ordinary act in the world.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "blocks"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "act"
            },
            "blocks": {
              "$ref": "urn:terrarium:contracts:0.3:blocks#/$defs/Action/properties/blocks"
            },
            "reasoning": {
              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "call"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "call"
            },
            "call": {
              "description": "An intent in the call language (contracts/calls.md), e.g. money(to=builder, amount=\"$500\"). The resolver turns it into the seat's own acts (docs/design/translator-and-resolver.md).",
              "type": "string",
              "maxLength": 4000
            },
            "reasoning": {
              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "propose"
            },
            "text": {
              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text"
            },
            "reasoning": {
              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "draft",
            "decision"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "sign"
            },
            "draft": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            },
            "decision": {
              "enum": [
                "accept",
                "reject"
              ]
            },
            "note": {
              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "to",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "message"
            },
            "to": {
              "$ref": "urn:terrarium:contracts:0.3:blocks#/$defs/message/properties/to"
            },
            "text": {
              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text"
            },
            "re": {
              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "wait"
            },
            "until": {
              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/SimTime"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "statement"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "opt_out"
            },
            "statement": {
              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Text"
            }
          }
        }
      ]
    },
    "ChannelData": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "accounts",
            "transactions"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "accounts"
            },
            "accounts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "account",
                  "holder",
                  "custodian",
                  "balance"
                ],
                "additionalProperties": false,
                "properties": {
                  "account": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                  },
                  "holder": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                  },
                  "custodian": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                  },
                  "balance": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Cents"
                  }
                }
              }
            },
            "transactions": {
              "description": "Transfers touching these accounts since the seat's previous observation.",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "t",
                  "from",
                  "to",
                  "amount",
                  "by"
                ],
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/SimTime"
                  },
                  "from": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                  },
                  "to": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                  },
                  "amount": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Amount"
                  },
                  "by": {
                    "description": "The seat that executed it.",
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/ConfigId"
                  },
                  "settles": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                  },
                  "per_instruction": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                  },
                  "memo": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "records"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "records"
            },
            "records": {
              "type": "array",
              "items": {
                "$ref": "urn:terrarium:contracts:0.3:records#/$defs/Record"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "as_of",
            "parcels"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sites"
            },
            "as_of": {
              "description": "When this view was last refreshed (see the channel's 'every').",
              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/SimTime"
            },
            "parcels": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "parcel",
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false,
                "properties": {
                  "parcel": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                  },
                  "x": {
                    "type": "integer"
                  },
                  "y": {
                    "type": "integer"
                  },
                  "w": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "h": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "structure": {
                    "type": "object",
                    "required": [
                      "structure",
                      "type",
                      "complete",
                      "occupancy"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "structure": {
                        "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                      },
                      "type": {
                        "$ref": "urn:terrarium:contracts:0.3:common#/$defs/ConfigId"
                      },
                      "built_by": {
                        "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                      },
                      "complete": {
                        "type": "boolean"
                      },
                      "completes_at": {
                        "$ref": "urn:terrarium:contracts:0.3:common#/$defs/SimTime"
                      },
                      "occupancy": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "occupant",
                            "slot",
                            "count"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "occupant": {
                              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                            },
                            "slot": {
                              "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Label"
                            },
                            "count": {
                              "type": "integer",
                              "minimum": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "entities",
            "seats"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "directory"
            },
            "entities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "entity",
                  "kind",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "entity": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                  },
                  "kind": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Label"
                  },
                  "name": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Name"
                  }
                }
              }
            },
            "seats": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "seat",
                  "entity",
                  "status"
                ],
                "additionalProperties": false,
                "properties": {
                  "seat": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/ConfigId"
                  },
                  "entity": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Id"
                  },
                  "title": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Name"
                  },
                  "role": {
                    "$ref": "urn:terrarium:contracts:0.3:common#/$defs/Label"
                  },
                  "status": {
                    "enum": [
                      "active",
                      "opted_out"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
